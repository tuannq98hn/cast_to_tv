<?xml version="1.0" encoding="utf-8"?>
<!-- Remote header (Stitch "Smart Remote Redesigned"): glass back key, centered title + TV chip, cyan cast key.
     Same view IDs as item_header for the ones RemoteActivity uses. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingHorizontal="@dimen/_16sdp"
    android:paddingVertical="@dimen/_6sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/imv_back"
        android:background="@drawable/dc_bg_glass_square"
        android:foreground="?attr/selectableItemBackground"
        android:padding="@dimen/_7sdp"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="@dimen/_32sdp"
        android:layout_centerVertical="true"
        android:src="@drawable/dc_ic_chevron_left"
        android:contentDescription="@string/remote_key_back"
        app:tint="@color/dc_key_icon"/>
    <ImageView
        android:id="@+id/cast_connect"
        android:background="@drawable/dc_bg_cast_button"
        android:padding="@dimen/_7sdp"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="@dimen/_32sdp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:src="@drawable/dc_ic_cast"
        app:tint="@color/dc_primary_soft"/>
    <View
        android:id="@+id/cast_premium"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginHorizontal="@dimen/_38sdp">
        <TextView
            style="@style/DC.Text"
            android:id="@+id/tv_title"
            android:fontFamily="@font/pro_display_bold"
            android:textSize="@dimen/_15ssp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/remote_tv"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/dc_bg_device_chip"
            android:paddingHorizontal="@dimen/_8sdp"
            android:paddingVertical="@dimen/_2sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp">
            <View
                android:id="@+id/view_device_dot"
                android:background="@drawable/dc_bg_pulse_dot"
                android:layout_width="@dimen/_5sdp"
                android:layout_height="@dimen/_5sdp"/>
            <TextView
                style="@style/DC.Text"
                android:id="@+id/tv_device_name"
                android:fontFamily="@font/pro_display_medium"
                android:letterSpacing="0.06"
                android:textAllCaps="true"
                android:textColor="#a5f3fc"
                android:textSize="@dimen/_8ssp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:text="@string/tab_to_connect"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
