<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/rl_item"
    android:background="@drawable/ripple_effect_exit"
    android:paddingTop="@dimen/_4sdp"
    android:paddingBottom="@dimen/_4sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/_8sdp"
    android:layout_marginRight="@dimen/_8sdp"
    android:layout_marginHorizontal="@dimen/_8sdp">
    <ImageView
        android:id="@+id/imv_close"
        android:background="@drawable/ripple_effect_exit"
        android:padding="@dimen/_1sdp"
        android:layout_width="@dimen/_28sdp"
        android:layout_height="@dimen/_28sdp"
        android:src="@drawable/ic_remove_video"
        app:tint="@color/dc_text_muted"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/_5sdp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/imv_close"
        android:layout_marginStart="@dimen/_10sdp">
        <ImageView
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:src="@drawable/ic_drag_handle"
            app:tint="@color/dc_text_subtle"/>
        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/_64sdp"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_marginBottom="@dimen/_4sdp"
            android:layout_marginStart="@dimen/_10sdp"
            app:cardCornerRadius="@dimen/_8sdp"
            app:cardBackgroundColor="@color/dc_bg_alt"
            app:cardElevation="0dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/img_video_offline"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_38sdp"
                    android:scaleType="centerCrop"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
        <TextView
            android:textSize="@dimen/_14sdp"
            android:textColor="@color/dc_text_primary"
            android:ellipsize="marquee"
            android:id="@+id/tv_name"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:fontFamily="@font/pro_display_medium"
            android:layout_marginStart="@dimen/_10sdp"/>
    </LinearLayout>
</RelativeLayout>
