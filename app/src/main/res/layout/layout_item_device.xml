<?xml version="1.0" encoding="utf-8"?>
<!-- Dark Cinema device card (Figma 1:1073 "Interactive Device Cards List"): r16 card, round icon well, name + services. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/dc_bg_device_card"
    android:padding="@dimen/_14sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/_16sdp"
    android:layout_marginVertical="@dimen/_4sdp">
    <FrameLayout
        android:background="@drawable/dc_bg_device_icon"
        android:layout_width="@dimen/_42sdp"
        android:layout_height="@dimen/_42sdp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/img_device"
            android:layout_width="@dimen/_26sdp"
            android:layout_height="@dimen/_18sdp"
            android:src="@drawable/ic_connected_home"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/_14sdp">
        <TextView
            android:id="@+id/text_device_name"
            style="@style/DC.Text.CardTitle"
            android:textColor="@color/dc_text_body"
            android:ellipsize="end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="device name"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/text_device_type"
            style="@style/DC.Text.Caption"
            android:textColor="@color/dc_text_secondary"
            android:ellipsize="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:text="DLNA"
            android:lines="1"/>
    </LinearLayout>
    <RelativeLayout
        android:visibility="gone"
        android:layout_width="@dimen/_35sdp"
        android:layout_height="@dimen/_35sdp">
        <ImageView
            android:id="@+id/img_connect"
            android:visibility="invisible"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:src="@drawable/ic_header_connected"
            android:layout_centerInParent="true"/>
        <ProgressBar
            android:theme="@style/progressBarBlue"
            android:id="@+id/progress_connect"
            android:layout_width="@dimen/_35sdp"
            android:layout_height="@dimen/_35sdp"
            android:indeterminate="false"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</LinearLayout>
