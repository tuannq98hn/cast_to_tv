<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/bg_item_web_cast"
    android:layout_width="match_parent"
    android:layout_height="@dimen/p56"
    android:layout_marginLeft="@dimen/_16sdp"
    android:layout_marginTop="@dimen/_4sdp"
    android:layout_marginRight="@dimen/_16sdp"
    android:layout_marginBottom="@dimen/_4sdp"
    android:layout_marginHorizontal="@dimen/_16sdp">
    <LinearLayout
        android:orientation="horizontal"
        android:paddingLeft="@dimen/_16sdp"
        android:paddingRight="@dimen/_16sdp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/_16sdp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/img_device"
                android:layout_width="@dimen/_44sdp"
                android:layout_height="@dimen/_24sdp"
                android:src="@drawable/ic_connected_home"/>
            <RelativeLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/_5sdp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_16sdp"
                    android:layout_marginRight="@dimen/_16sdp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginHorizontal="@dimen/_16sdp">
                    <TextView
                        android:textSize="@dimen/_14sdp"
                        android:textColor="@color/color_text_new"
                        android:ellipsize="end"
                        android:id="@+id/text_device_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="device name"
                        android:maxLines="1"
                        android:fontFamily="@font/pro_display_bold"/>
                    <TextView
                        android:textSize="@dimen/_11sdp"
                        android:textColor="@color/text_default"
                        android:id="@+id/text_device_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:text="DLNA"
                        android:lines="1"
                        android:fontFamily="@font/pro_display_regular"/>
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
        <RelativeLayout
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/img_connect"
                android:visibility="invisible"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:src="@drawable/ic_header_connected"
                android:layout_centerInParent="true"/>
            <ProgressBar
                android:theme="@style/progressBarBlue"
                android:id="@+id/progress_connect"
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_35sdp"
                android:indeterminate="false"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
