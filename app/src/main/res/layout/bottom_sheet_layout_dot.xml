<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/transparency"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="@dimen/_136sdp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_bottom_sheet_remote"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_136sdp"
        app:layout_constraintBottom_toBottomOf="parent">
        <View
            android:id="@+id/view5"
            android:background="@drawable/bg_line_remote"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_4sdp"
            android:layout_marginTop="@dimen/_8sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:id="@+id/constraintLayout7"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginTop="@dimen/_24sdp"
            android:layout_marginBottom="@dimen/_24sdp"
            android:layout_marginVertical="@dimen/_24sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view5">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/llRedLG"
                android:background="@drawable/bg_border_red"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/_24sdp"
                app:layout_constraintStart_toStartOf="parent"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/llGreenLG"
                android:background="@drawable/bg_border_green"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toStartOf="@+id/llYellowLG"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/llRedLG"
                app:layout_constraintWidth_percent="0.111"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/llYellowLG"
                android:background="@drawable/bg_border_yellow"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toStartOf="@+id/llBlueLG"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/llGreenLG"
                app:layout_constraintWidth_percent="0.111"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/llBlueLG"
                android:background="@drawable/bg_border_blue"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/_20sdp"
                android:layout_marginEnd="@dimen/_24sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintWidth_percent="0.111"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
