<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/dc_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/viewHeader"
        layout="@layout/item_header"/>
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/linearProgress"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        app:indicatorColor="@color/dc_primary"
        app:layout_constraintBottom_toBottomOf="@+id/viewHeader"/>
    <WebView
        android:id="@+id/page"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/ctl_bottom"
        app:layout_constraintTop_toBottomOf="@+id/linearProgress"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/ctl_bottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_56sdp"
        app:cardBackgroundColor="@color/dc_surface"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_56sdp"
            app:layout_constraintBottom_toBottomOf="parent">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/imv_data"
                android:visibility="gone"
                android:layout_width="@dimen/_45sdp"
                android:layout_height="@dimen/_45sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:lottie_autoPlay="true"
                app:lottie_fileName="ani_web.json"
                app:lottie_loop="true"/>
            <ImageView
                android:id="@+id/imv_youtubeBrowserList"
                android:padding="@dimen/_5sdp"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:src="@drawable/ic_yt_list_empty"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/imv_youtubeBrowserBack"
                android:padding="@dimen/_5sdp"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:src="@drawable/ic_yt_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/imv_youtubeBrowserForward"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/imv_youtubeBrowserForward"
                android:padding="@dimen/_5sdp"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:src="@drawable/ic_yt_next"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/imv_youtubeBrowserBack"
                app:layout_constraintRight_toLeftOf="@+id/imv_youtubeBrowserList"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/imv_youtubeBrowserHome"
                android:padding="@dimen/_5sdp"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:src="@drawable/ic_home_browser"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/imv_youtubeBrowserList"
                app:layout_constraintRight_toLeftOf="@+id/imv_youtubeBrowserReload"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/imv_youtubeBrowserReload"
                android:padding="@dimen/_5sdp"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:src="@drawable/ic_yt_reload"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/imv_youtubeBrowserHome"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
