<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/dc_bg_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/_20sdp"
    android:layout_marginRight="@dimen/_20sdp"
    android:layout_marginHorizontal="@dimen/_20sdp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_15sdp"
        android:layout_marginBottom="@dimen/_15sdp"
        android:layout_marginStart="@dimen/_15sdp"
        android:layout_marginEnd="@dimen/_15sdp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/_14sdp"
                android:textColor="@color/dc_text_primary"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_resource_found"
                android:fontFamily="@font/pro_display_medium"/>
        </LinearLayout>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/_38sdp"
            android:layout_marginLeft="@dimen/_30sdp"
            android:layout_marginTop="@dimen/_24sdp"
            android:layout_marginRight="@dimen/_30sdp"
            android:layout_marginBottom="@dimen/_24sdp"
            android:src="@drawable/img_yt_resource"
            android:layout_marginHorizontal="@dimen/_30sdp"
            android:layout_marginVertical="@dimen/_24sdp"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/dc_text_muted"
                android:id="@+id/textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/please_play_the_video_first_and_the_resource_button_will_be_available_after_the_resource_detected"
                android:fontFamily="@font/pro_display_regular"/>
            <TextView
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/dc_text_muted"
                android:id="@+id/text2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/you_can_also_refresh_page_to_have_a_try"
                android:layout_below="@+id/textview"
                android:fontFamily="@font/pro_display_regular"/>
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/rl_refresh"
                android:background="@drawable/dc_bg_cta_gradient"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_below="@+id/text2">
                <TextView
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/btn_close"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:layout_marginBottom="@dimen/_6sdp"
                    android:text="@string/refresh_page"
                    android:drawableLeft="@drawable/ic_refresh_white"
                    android:drawablePadding="@dimen/_8sdp"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/pro_display_regular"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:layout_marginEnd="@dimen/_6sdp"/>
            </RelativeLayout>
        </RelativeLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/imv_close"
        android:padding="@dimen/_5sdp"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:layout_marginTop="@dimen/_7sdp"
        android:layout_marginRight="@dimen/_4sdp"
        android:src="@drawable/ic_close_black"
        app:tint="@color/dc_text_muted"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
</RelativeLayout>
