<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_permission_0"
    android:background="@drawable/dc_bg_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/handle"
        android:background="@drawable/dc_bg_chip"
        android:backgroundTint="@color/dc_radio_off"
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_marginTop="@dimen/_10sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_main"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_16sdp"
        android:src="@drawable/img_permission_android_13"
        app:layout_constraintDimensionRatio="1.3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/handle"
        app:layout_constraintWidth_percent="0.5"/>
    <androidx.appcompat.widget.AppCompatTextView
        style="@style/DC.Text.Title"
        android:textSize="@dimen/_20ssp"
        android:gravity="center"
        android:id="@+id/txt_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_24sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginRight="@dimen/_24sdp"
        android:text="@string/text_permission"
        android:layout_marginHorizontal="@dimen/_24sdp"
        app:layout_constraintTop_toBottomOf="@+id/img_main"/>
    <androidx.appcompat.widget.AppCompatTextView
        style="@style/DC.Text.Body"
        android:textSize="@dimen/_13ssp"
        android:textColor="@color/dc_text_muted"
        android:gravity="center"
        android:id="@+id/txt_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_24sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginRight="@dimen/_24sdp"
        android:fontFamily="@font/pro_display_regular"
        android:layout_marginHorizontal="@dimen/_24sdp"
        app:layout_constraintTop_toBottomOf="@+id/txt_main"/>
    <Button
        style="@style/DC.Text.Button"
        android:textColor="@color/dc_text_primary"
        android:id="@+id/btn_allow"
        android:background="@drawable/dc_bg_cta_gradient"
        android:stateListAnimator="@null"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_46sdp"
        android:layout_marginLeft="@dimen/_24sdp"
        android:layout_marginTop="@dimen/_24sdp"
        android:layout_marginRight="@dimen/_24sdp"
        android:text="@string/text_allow"
        android:textAllCaps="false"
        android:fontFamily="@font/pro_display_bold"
        android:layout_marginHorizontal="@dimen/_24sdp"
        app:layout_constraintTop_toBottomOf="@+id/txt_detail"/>
    <TextView
        android:textSize="@dimen/_14ssp"
        android:textColor="@color/dc_text_muted"
        android:gravity="center"
        android:id="@+id/txt_deny"
        android:paddingBottom="@dimen/_26sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_40sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginRight="@dimen/_40sdp"
        android:text="@string/text_deny"
        android:paddingTop="@dimen/_6sdp"
        android:fontFamily="@font/pro_display_semibold"
        android:layout_marginHorizontal="@dimen/_40sdp"
        app:layout_constraintTop_toBottomOf="@+id/btn_allow"/>
</androidx.constraintlayout.widget.ConstraintLayout>
