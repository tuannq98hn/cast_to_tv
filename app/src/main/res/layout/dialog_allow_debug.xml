<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@color/transparent"
    android:paddingLeft="@dimen/_16sdp"
    android:paddingRight="@dimen/_16sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/_16sdp">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_border"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/_18sdp"
            android:textColor="@color/color_txt"
            android:gravity="center"
            android:id="@+id/tv_connectFireTV"
            android:paddingLeft="@dimen/_10sdp"
            android:paddingRight="@dimen/_10sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_24sdp"
            android:text="@string/allow_usb_debugging_on_tv"
            android:fontFamily="@font/pro_display_medium"
            android:paddingHorizontal="@dimen/_10sdp"/>
        <TextView
            android:gravity="center_horizontal"
            android:id="@+id/text1"
            android:paddingLeft="@dimen/_12sdp"
            android:paddingRight="@dimen/_12sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:text="@string/on_your_tv_if_prompt_asked_for_allow_debugging"
            android:layout_below="@+id/tv_connectFireTV"
            android:fontFamily="@font/roboto_regular"
            android:paddingHorizontal="@dimen/_12sdp"/>
        <TextView
            android:textSize="@dimen/_12sdp"
            android:textColor="@color/color_txt"
            android:id="@+id/text2"
            android:paddingLeft="@dimen/_10sdp"
            android:paddingRight="@dimen/_10sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp"
            android:text="@string/_1_press_check_always_allow_from_this_computer"
            android:layout_below="@+id/text1"
            android:fontFamily="@font/roboto_regular"
            android:paddingHorizontal="@dimen/_10sdp"/>
        <TextView
            android:textSize="@dimen/_12sdp"
            android:textColor="@color/color_txt"
            android:id="@+id/text3"
            android:paddingLeft="@dimen/_10sdp"
            android:paddingRight="@dimen/_10sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="@string/_2_select_ok_button"
            android:layout_below="@+id/text2"
            android:fontFamily="@font/roboto_regular"
            android:paddingHorizontal="@dimen/_10sdp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_16sdp"
            android:layout_marginRight="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_16sdp"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginVertical="@dimen/_16sdp">
            <CheckBox
                android:id="@+id/imv_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:button="@drawable/checkbox_selector"/>
            <TextView
                android:textSize="@dimen/_13sdp"
                android:textColor="@color/color_txt"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/i_know_don_t_show_this_again"
                android:drawablePadding="@dimen/_6sdp"
                android:fontFamily="@font/pro_display_medium"
                android:layout_marginStart="@dimen/_5sdp"/>
        </LinearLayout>
        <Button
            android:textSize="@dimen/_15sdp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_ok"
            android:background="@drawable/bg_button_pro"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_18sdp"
            android:text="@string/ok"
            android:fontFamily="@font/pro_display_medium"
            android:layout_marginHorizontal="@dimen/_10sdp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
