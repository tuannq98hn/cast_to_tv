<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/include3"
        app:layout_constraintBottom_toBottomOf="parent"
        layout="@layout/item_header"/>
    <RelativeLayout
        android:id="@+id/rlt_native_ads"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/include3">
        <FrameLayout android:visibility="gone"
            android:id="@+id/main_ads_native"
            android:background="#f3f6ff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_5sdp"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/imv_photoAction"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_24sdp"
        android:layout_marginRight="@dimen/_20sdp"
        android:layout_marginBottom="@dimen/_24sdp"
        android:src="@drawable/img_remote_sony"
        android:scaleType="centerInside"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:layout_marginVertical="@dimen/_24sdp"
        app:layout_constraintBottom_toTopOf="@+id/btn_startCast"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rlt_native_ads"/>
    <TextView
        android:textSize="@dimen/_14sdp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/btn_startCast"
        android:background="@drawable/bg_btn_refresh"
        android:paddingTop="@dimen/_10sdp"
        android:paddingBottom="@dimen/_10sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_12sdp"
        android:layout_marginRight="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:text="@string/start_cast"
        android:fontFamily="@font/pro_display_medium"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:paddingVertical="@dimen/_10sdp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/linear_videoView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_marginRight="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_12sdp"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginVertical="@dimen/_12sdp"
        app:layout_constraintBottom_toTopOf="@+id/btn_startCast"
        app:layout_constraintTop_toBottomOf="@+id/rlt_native_ads">
        <VideoView
            android:layout_gravity="center"
            android:id="@+id/myvideoview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <ProgressBar
        android:theme="@style/progressBarBlue"
        android:id="@+id/progressBar"
        android:visibility="gone"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:layout_marginTop="@dimen/_16sdp"
        android:layout_marginBottom="@dimen/_16sdp"
        android:layout_centerHorizontal="true"
        android:layout_marginVertical="@dimen/_16sdp"
        app:layout_constraintBottom_toTopOf="@+id/btn_startCast"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rlt_native_ads"/>
</androidx.constraintlayout.widget.ConstraintLayout>
