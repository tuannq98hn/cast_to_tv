<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/dc_bg_sheet"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_400sdp"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="@dimen/_16sdp"
            android:textColor="@color/dc_text_primary"
            android:id="@+id/tv_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_14sdp"
            android:text="@string/file_available"
            android:fontFamily="@font/pro_display_bold"
            app:layout_constraintBottom_toBottomOf="@+id/imv_dialogBsfYoutubeClose"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@+id/imv_dialogBsfYoutubeClose"/>
        <TextView
            android:textColor="@color/dc_text_body"
            android:id="@+id/tv_text1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_14sdp"
            android:text="@string/route_mode"
            android:fontFamily="@font/pro_display_regular"
            app:layout_constraintBottom_toBottomOf="@+id/imv_dialogBsfYoutubeHelp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@+id/imv_dialogBsfYoutubeHelp"/>
        <TextView
            android:textColor="@color/dc_text_muted"
            android:id="@+id/tv_help"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_14sdp"
            android:layout_marginTop="@dimen/_6sdp"
            android:layout_marginRight="@dimen/_22sdp"
            android:text="@string/different_videos_may_require_different_modes_try_to_swith_the_mode_when_videos_can_t_be_cast_successfully"
            android:fontFamily="@font/roboto_regular"
            app:layout_constraintTop_toBottomOf="@+id/imv_dialogBsfYoutubeHelp"/>
        <ImageView
            android:id="@+id/imv_dialogBsfYoutubeClose"
            android:padding="@dimen/_7sdp"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_margin="@dimen/_12sdp"
            android:src="@drawable/ic_close_black"
            app:tint="@color/dc_text_muted"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/imv_dialogBsfYoutubeHelp"
            android:padding="@dimen/_5sdp"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginLeft="@dimen/_8sdp"
            android:layout_marginTop="@dimen/_14sdp"
            android:src="@drawable/ic_help_black"
            app:tint="@color/dc_primary"
            app:layout_constraintLeft_toRightOf="@+id/tv_text1"
            app:layout_constraintTop_toBottomOf="@+id/tv_text"/>
        <View
            android:id="@+id/line1"
            android:background="@color/dc_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/_16sdp"
            app:layout_constraintTop_toBottomOf="@+id/tv_help"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:overScrollMode="never"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/line1">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
