<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/bannerAds"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="@dimen/_8sdp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/imageView2"
                android:background="@drawable/bg_header_home"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="1.57:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <RelativeLayout
                android:id="@+id/include"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/imv_setting"
                    android:padding="@dimen/_7sdp"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:src="@drawable/ic_setting"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:layout_marginVertical="@dimen/_8sdp"/>
                <TextView
                    android:textSize="@dimen/_20sdp"
                    android:textColor="#202020"
                    android:gravity="center"
                    android:id="@+id/txt_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:layout_alignTop="@+id/imv_setting"
                    android:layout_alignBottom="@+id/imv_setting"
                    android:fontFamily="@font/pro_display_bold"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:layout_toEndOf="@+id/imv_setting"/>
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/cast_premium"
                    android:layout_width="@dimen/_95sdp"
                    android:layout_height="@dimen/_28sdp"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/_16sdp"
                    android:layout_alignParentEnd="true"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/anim_premium"/>
            </RelativeLayout>
            <TextView
                android:textSize="@dimen/_14sdp"
                android:textColor="@color/color_text_new"
                android:id="@+id/textView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_15sdp"
                android:text="@string/four_ensure"
                android:fontFamily="@font/pro_display_medium"
                android:layout_marginStart="@dimen/_16sdp"
                app:layout_constraintBottom_toTopOf="@+id/rl_connect"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/include"
                app:layout_constraintWidth_percent="0.67"/>
            <RelativeLayout
                android:id="@+id/rl_connect"
                android:background="@drawable/bg_content_feedback"
                android:layout_width="0dp"
                android:layout_height="@dimen/_63sdp"
                android:layout_marginLeft="@dimen/_16sdp"
                android:layout_marginRight="@dimen/_16sdp"
                android:layout_marginBottom="@dimen/_20sdp"
                android:elevation="@dimen/_2sdp"
                android:layout_marginHorizontal="@dimen/_16sdp"
                app:layout_constraintBottom_toBottomOf="@+id/imageView2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.67">
                <ImageView
                    android:id="@+id/imv_connect"
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_no_connect_home"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/_16sdp"/>
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/img_next"
                    android:padding="@dimen/_4sdp"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:layout_alignParentEnd="true"
                    app:lottie_autoPlay="true"
                    app:lottie_fileName="anim_arrow.json"
                    app:lottie_loop="true"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:clickable="false"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_toStartOf="@+id/img_next"
                    android:layout_toEndOf="@+id/imv_connect">
                    <TextView
                        android:textSize="@dimen/_16sdp"
                        android:textColor="@color/color_text_new"
                        android:ellipsize="end"
                        android:id="@+id/tvTitleConnect"
                        android:clickable="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/text_connect_to_tv"
                        android:maxLines="1"
                        android:fontFamily="@font/pro_display_bold"/>
                    <TextView
                        android:textSize="@dimen/_11sdp"
                        android:id="@+id/tvStatusConnect"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:text="@string/tab_to_connect"
                        android:maxLines="1"
                        android:fontFamily="@font/pro_display_regular"/>
                </LinearLayout>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/linearLayout23"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_16sdp"
                android:layout_marginRight="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_16sdp"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:layout_marginVertical="@dimen/_16sdp"
                app:layout_constraintTop_toBottomOf="@+id/imageView2">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/rl_mirror"
                    android:background="@drawable/bg_mirror_home"
                    android:paddingTop="@dimen/_16sdp"
                    android:paddingBottom="@dimen/_16sdp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_100sdp"
                    android:paddingVertical="@dimen/_16sdp">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_20sdp"
                        android:layout_marginRight="@dimen/_20sdp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="@dimen/_20sdp">
                        <TextView
                            android:textSize="@dimen/_20sdp"
                            android:textColor="@color/white"
                            android:clickable="false"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_screen_mirror"
                            android:fontFamily="@font/pro_display_bold"/>
                        <TextView
                            android:textSize="@dimen/_14sdp"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:clickable="false"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mirror_phone_s_screen_to_tv"
                            android:fontFamily="@font/pro_display_medium"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <com.airbnb.lottie.LottieAnimationView
                        android:layout_gravity="end"
                        android:id="@+id/img_anim_loading"
                        android:clickable="false"
                        android:layout_width="@dimen/_72sdp"
                        android:layout_height="@dimen/_56sdp"
                        android:layout_marginEnd="@dimen/_16sdp"
                        app:lottie_autoPlay="true"
                        app:lottie_fileName="anim_home.json"
                        app:lottie_loop="true"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:id="@+id/rl_remote"
                        android:background="@drawable/bg_remote_home"
                        android:padding="@dimen/_16sdp"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_100sdp"
                        android:layout_weight="1"
                        android:layout_marginEnd="1dp">
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_remote_home"
                            android:layout_marginStart="@dimen/_8sdp"/>
                        <TextView
                            android:textSize="@dimen/_16sdp"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:text="@string/remote_tv"
                            android:fontFamily="@font/pro_display_bold"
                            android:layout_marginStart="@dimen/_8sdp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:id="@+id/ct_youtube"
                        android:background="@drawable/bg_youtube_home"
                        android:padding="@dimen/_16sdp"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_100sdp"
                        android:layout_weight="1"
                        android:layout_marginStart="1dp">
                        <ImageView
                            android:layout_width="@dimen/_28sdp"
                            android:layout_height="@dimen/_28sdp"
                            android:src="@drawable/ic_youtube_home"
                            android:layout_marginStart="@dimen/_8sdp"/>
                        <TextView
                            android:textSize="@dimen/_16sdp"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:text="@string/cast_youtube"
                            android:fontFamily="@font/pro_display_bold"
                            android:layout_marginStart="@dimen/_8sdp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llAds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/linearLayout23">
                <FrameLayout android:visibility="gone"
                    android:id="@+id/nativeAds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginVertical="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/lnl_banner"
                    android:background="@color/white"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <FrameLayout android:visibility="gone"
                        android:id="@+id/main_ads_native"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:layout_marginBottom="@dimen/_10sdp"
                        android:layout_marginVertical="@dimen/_10sdp"
                        app:layout_constraintBottom_toBottomOf="parent"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/_18sdp"
                android:textColor="@color/color_text_new"
                android:id="@+id/txt_tv_cast"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginRight="@dimen/_16sdp"
                android:text="@string/text_tv_cast"
                android:fontFamily="@font/pro_display_bold"
                android:layout_marginHorizontal="@dimen/_16sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/llAds"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_function"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginRight="@dimen/_16sdp"
                android:layout_marginHorizontal="@dimen/_16sdp"
                app:layout_constraintTop_toBottomOf="@+id/txt_tv_cast">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:id="@+id/ll_photo_off"
                        android:background="@drawable/bg_photo_home"
                        android:padding="@dimen/_16sdp"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/_6sdp">
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_photo_home"/>
                        <TextView
                            android:textSize="@dimen/_16sdp"
                            android:textColor="@color/color_text_new"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_6sdp"
                            android:text="@string/menu_photo"
                            android:fontFamily="@font/pro_display_bold"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:id="@+id/ct_vimeo"
                        android:background="@drawable/bg_vimeo_home"
                        android:padding="@dimen/_16sdp"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/_6sdp">
                        <ImageView
                            android:layout_width="@dimen/_28sdp"
                            android:layout_height="@dimen/_28sdp"
                            android:src="@drawable/ic_vimeo"/>
                        <TextView
                            android:textSize="@dimen/_16sdp"
                            android:textColor="@color/color_text_new"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_6sdp"
                            android:text="@string/vimeo"
                            android:fontFamily="@font/pro_display_bold"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:id="@+id/ll_video_off"
                        android:background="@drawable/bg_video_home"
                        android:padding="@dimen/_12sdp"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/_6sdp">
                        <ImageView
                            android:layout_width="@dimen/_28sdp"
                            android:layout_height="@dimen/_28sdp"
                            android:src="@drawable/ic_video_home"/>
                        <TextView
                            android:textSize="@dimen/_16sdp"
                            android:textColor="@color/color_text_new"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_6sdp"
                            android:text="@string/menu_video"
                            android:fontFamily="@font/pro_display_bold"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:id="@+id/ct_driver"
                        android:background="@drawable/bg_web_home"
                        android:padding="@dimen/_12sdp"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/_6sdp">
                        <ImageView
                            android:layout_width="@dimen/_28sdp"
                            android:layout_height="@dimen/_28sdp"
                            android:src="@drawable/ic_browser_home"/>
                        <TextView
                            android:textSize="@dimen/_16sdp"
                            android:textColor="@color/color_text_new"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_6sdp"
                            android:text="@string/text_browser"
                            android:fontFamily="@font/pro_display_bold"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout android:visibility="gone"
        android:id="@+id/bannerAds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/llThanksAds"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_width="@dimen/_230sdp"
                android:layout_height="@dimen/_190sdp"
                android:src="@drawable/imv_tks_ads"/>
            <TextView
                android:textSize="@dimen/_14sdp"
                android:textColor="#151515"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_30sdp"
                android:text="@string/thanks_ads"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
