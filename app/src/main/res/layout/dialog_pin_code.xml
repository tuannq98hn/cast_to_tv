<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@color/transparent"
    android:paddingLeft="@dimen/_24sdp"
    android:paddingRight="@dimen/_24sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/_24sdp">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/dc_bg_dialog"
        android:padding="@dimen/_24sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/_16sdp"
            android:textColor="@color/dc_text_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:text="@string/enter_the_pin_code"
            android:fontFamily="@font/pro_display_medium"/>
        <EditText
            android:textColor="@color/dc_text_primary"
            android:textColorHint="@color/dc_text_subtle"
            android:id="@+id/edt_pinCodeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:minHeight="48dp"
            android:lines="1"
            android:fontFamily="@font/pro_display_medium"
            android:backgroundTint="@color/dc_primary_soft"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_15sdp">
            <TextView
                android:textColor="@color/dc_text_body"
                android:gravity="center"
                android:id="@+id/tv_pinCodeCancel"
                android:background="@drawable/dc_bg_button_secondary"
                android:padding="@dimen/_10sdp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/_16sdp"
                android:text="@string/cancel_dialog"
                android:layout_weight="1"
                android:layout_toLeftOf="@+id/tv_pinCodeOk"
                android:fontFamily="@font/pro_display_bold"/>
            <TextView
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_pinCodeOk"
                android:background="@drawable/dc_bg_cta_gradient"
                android:padding="@dimen/_10sdp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/ok"
                android:layout_weight="1"
                android:fontFamily="@font/pro_display_bold"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
