<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@color/transparent"
    android:paddingLeft="@dimen/_24sdp"
    android:paddingRight="@dimen/_24sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/_24sdp">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_border"
        android:padding="@dimen/_10sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:textColor="#939393"
            android:id="@+id/edt_pinCodeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="@string/search_here"
            android:lines="1"
            android:drawableRight="@drawable/ic_fire_tv_search_gray"
            android:fontFamily="@font/pro_display_medium"
            android:backgroundTint="@color/color_main"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp">
            <TextView
                android:textColor="@color/color_txt"
                android:id="@+id/tv_pinCodeOk"
                android:padding="@dimen/_8sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/_12sdp"
                android:text="@string/ok"
                android:layout_alignParentRight="true"
                android:fontFamily="@font/pro_display_regular"/>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
