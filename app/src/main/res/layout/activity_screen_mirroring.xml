<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_main"
    android:tag="layout/activity_screen_mirroring_0"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/_12sdp"
        app:layout_constraintBottom_toTopOf="@+id/nativeAds"
        app:layout_constraintTop_toBottomOf="@+id/ll_top">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/ab_top"
            android:background="@color/white"
            android:fitsSystemWindows="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_220sdp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_scrollFlags="snap|exitUntilCollapsed|scroll">
                <View
                    android:id="@+id/view"
                    android:background="@drawable/bg_header_miror"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/sv_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <LinearLayout
                android:orientation="vertical"
                android:paddingLeft="@dimen/_16sdp"
                android:paddingRight="@dimen/_16sdp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:paddingHorizontal="@dimen/_16sdp"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="@dimen/_14sdp"
                    android:textColor="@color/color_des"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:text="@string/select_the_connection"
                    android:fontFamily="@font/pro_display_bold"/>
                <TextView
                    android:textSize="@dimen/_13sdp"
                    android:textColor="@color/color_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/choose_a_screencast_scene"
                    android:fontFamily="@font/pro_display_regular"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/llMirrorTV"
                    android:background="@drawable/bg_button_miror_tv"
                    android:paddingLeft="@dimen/_16sdp"
                    android:paddingRight="@dimen/_16sdp"
                    android:paddingBottom="@dimen/_8sdp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_110sdp"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:paddingHorizontal="@dimen/_16sdp">
                    <View
                        android:background="@drawable/ic_mirror_tv"
                        android:clickable="false"
                        android:layout_width="@dimen/_48sdp"
                        android:layout_height="@dimen/_48sdp"
                        android:elevation="@dimen/_4sdp"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:clickable="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_16sdp"
                        android:layout_marginRight="@dimen/_16sdp"
                        android:layout_marginHorizontal="@dimen/_16sdp">
                        <TextView
                            android:textSize="@dimen/_16sdp"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/smart_tv"
                            android:fontFamily="@font/pro_display_bold"/>
                        <TextView
                            android:textSize="@dimen/_13sdp"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mobile_screen_sharing_to_tv"
                            android:fontFamily="@font/pro_display_regular"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/llMirrorDirect"
                    android:background="@drawable/bg_button_mirror_direct"
                    android:paddingLeft="@dimen/_16sdp"
                    android:paddingRight="@dimen/_16sdp"
                    android:paddingBottom="@dimen/_8sdp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_110sdp"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:elevation="@dimen/_4sdp"
                    android:paddingHorizontal="@dimen/_16sdp">
                    <View
                        android:background="@drawable/ic_mirror_direct"
                        android:clickable="false"
                        android:layout_width="@dimen/_48sdp"
                        android:layout_height="@dimen/_48sdp"
                        android:elevation="@dimen/_4sdp"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:clickable="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_16sdp"
                        android:layout_marginRight="@dimen/_16sdp"
                        android:layout_marginHorizontal="@dimen/_16sdp">
                        <TextView
                            android:textSize="@dimen/_16sdp"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/direct_mirror"
                            android:fontFamily="@font/pro_display_bold"/>
                        <TextView
                            android:textSize="@dimen/_13sdp"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/txt_detail_direct"
                            android:fontFamily="@font/pro_display_regular"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/llMirrorWeb"
                    android:background="@drawable/bg_button_miror_web"
                    android:paddingLeft="@dimen/_16sdp"
                    android:paddingRight="@dimen/_16sdp"
                    android:paddingBottom="@dimen/_8sdp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_110sdp"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:elevation="@dimen/_4sdp"
                    android:paddingHorizontal="@dimen/_16sdp">
                    <View
                        android:background="@drawable/ic_mirror_web"
                        android:clickable="false"
                        android:layout_width="@dimen/_48sdp"
                        android:layout_height="@dimen/_48sdp"
                        android:elevation="@dimen/_4sdp"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:clickable="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_16sdp"
                        android:layout_marginRight="@dimen/_16sdp"
                        android:layout_marginHorizontal="@dimen/_16sdp">
                        <TextView
                            android:textSize="@dimen/_16sdp"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mirror_web_browser"
                            android:fontFamily="@font/pro_display_bold"/>
                        <TextView
                            android:textSize="@dimen/_13sdp"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/typing_url_in"
                            android:fontFamily="@font/pro_display_regular"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_16sdp"
        android:layout_marginRight="@dimen/_16sdp"
        android:layout_marginHorizontal="@dimen/_16sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_scrollFlags="enterAlways">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/img_back"
            android:padding="@dimen/_4sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_back_arrow"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_18sdp"
            android:textColor="@color/black"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_1sdp"
            android:layout_marginRight="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_1sdp"
            android:text="@string/screen_mirroring"
            android:layout_weight="1"
            android:fontFamily="@font/pro_display_bold"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginVertical="@dimen/_1sdp"/>
        <TextView
            android:textColor="@color/white"
            android:id="@+id/txt_faq"
            android:background="@drawable/bg_rounder_main"
            android:paddingLeft="@dimen/_8sdp"
            android:paddingTop="@dimen/_2sdp"
            android:paddingRight="@dimen/_8sdp"
            android:paddingBottom="@dimen/_2sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_faq"
            android:fontFamily="@font/pro_display_bold"
            android:paddingHorizontal="@dimen/_8sdp"
            android:paddingVertical="@dimen/_2sdp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>
