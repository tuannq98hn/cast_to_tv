<?xml version="1.0" encoding="utf-8"?>
<!-- Screen Mirroring mode picker (Stitch "Screen Mirroring (Dark Cinema)", "Select Connection Mode" section).
     Left out (no feature behind them): hero card with latency / FPS / Dolby / Wi-Fi stats, mode badges, brand chips,
     status lines, Stream Tuning (resolution, framerate, spatial audio), "Start Screen Mirroring" CTA, bottom nav. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_main"
    android:background="@drawable/dc_bg_ambient_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/header"
        layout="@layout/layout_media_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/sv_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header">
        <LinearLayout
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_14sdp"
            android:paddingTop="@dimen/_14sdp"
            android:paddingBottom="@dimen/_24sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    style="@style/DC.Text"
                    android:fontFamily="@font/pro_display_bold"
                    android:textSize="@dimen/_18ssp"
                    android:letterSpacing="-0.02"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/select_the_connection"/>
                <TextView
                    style="@style/DC.Text"
                    android:id="@+id/txt_faq"
                    android:background="@drawable/dc_bg_setup_guide"
                    android:drawableStart="@drawable/dc_ic_help_center"
                    android:drawablePadding="@dimen/_4sdp"
                    android:drawableTint="@color/dc_primary_soft"
                    android:fontFamily="@font/pro_display_semibold"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/_9sdp"
                    android:paddingVertical="@dimen/_4sdp"
                    android:textColor="@color/dc_primary_soft"
                    android:textSize="@dimen/_10ssp"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_faq"/>
            </LinearLayout>
            <TextView
                style="@style/DC.Text.Caption"
                android:textColor="@color/dc_text_muted"
                android:textSize="@dimen/_11ssp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:text="@string/choose_a_screencast_scene"/>
            <LinearLayout
                android:id="@+id/llMirrorTV"
                android:background="@drawable/dc_bg_mirror_card_active"
                android:orientation="vertical"
                android:padding="@dimen/_14sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_14sdp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:clipChildren="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:background="@drawable/dc_bg_mirror_icon_smart"
                            android:padding="@dimen/_12sdp"
                            android:layout_width="@dimen/_48sdp"
                            android:layout_height="@dimen/_48sdp"
                            android:src="@drawable/dc_ic_connected_tv_fill"
                            android:importantForAccessibility="no"
                        app:tint="@color/dc_text_primary"/>
                        <ImageView
                            android:background="@drawable/dc_bg_pill"
                            android:backgroundTint="#00f2fe"
                            android:padding="2dp"
                            android:layout_gravity="bottom|end"
                            android:layout_width="@dimen/_14sdp"
                            android:layout_height="@dimen/_14sdp"
                            android:src="@drawable/dc_ic_bolt"
                            android:importantForAccessibility="no"
                            app:tint="#0a0e17"/>
                    </FrameLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/_14sdp">
                        <TextView
                            style="@style/DC.Text"
                            android:fontFamily="@font/pro_display_bold"
                            android:textSize="@dimen/_15ssp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/smart_tv"/>
                        <TextView
                            style="@style/DC.Text.Caption"
                            android:textColor="@color/dc_key_icon"
                            android:textSize="@dimen/_10ssp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:text="@string/mobile_screen_sharing_to_tv"/>
                    </LinearLayout>
                </LinearLayout>
                <ImageView
                    android:layout_gravity="end"
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:src="@drawable/dc_ic_arrow_forward_small"
                    android:importantForAccessibility="no"
                    app:tint="@color/dc_primary_soft"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/llMirrorDirect"
                android:background="@drawable/dc_bg_mirror_card"
                android:orientation="vertical"
                android:padding="@dimen/_14sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:background="@drawable/dc_bg_mirror_icon_direct"
                        android:padding="@dimen/_12sdp"
                        android:layout_width="@dimen/_48sdp"
                        android:layout_height="@dimen/_48sdp"
                        android:src="@drawable/dc_ic_cast_fill"
                        android:importantForAccessibility="no"
                        app:tint="@color/dc_text_primary"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/_14sdp">
                        <TextView
                            style="@style/DC.Text"
                            android:fontFamily="@font/pro_display_bold"
                            android:textSize="@dimen/_15ssp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/direct_mirror"/>
                        <TextView
                            style="@style/DC.Text.Caption"
                            android:textColor="@color/dc_key_icon"
                            android:textSize="@dimen/_10ssp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:text="@string/txt_detail_direct"/>
                    </LinearLayout>
                </LinearLayout>
                <ImageView
                    android:layout_gravity="end"
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:src="@drawable/dc_ic_arrow_forward_small"
                    android:importantForAccessibility="no"
                    app:tint="@color/dc_key_icon"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/llMirrorWeb"
                android:background="@drawable/dc_bg_mirror_card"
                android:orientation="vertical"
                android:padding="@dimen/_14sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:background="@drawable/dc_bg_mirror_icon_web"
                        android:padding="@dimen/_12sdp"
                        android:layout_width="@dimen/_48sdp"
                        android:layout_height="@dimen/_48sdp"
                        android:src="@drawable/dc_ic_laptop_fill"
                        android:importantForAccessibility="no"
                        app:tint="@color/dc_text_primary"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/_14sdp">
                        <TextView
                            style="@style/DC.Text"
                            android:fontFamily="@font/pro_display_bold"
                            android:textSize="@dimen/_15ssp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mirror_web_browser"/>
                        <TextView
                            style="@style/DC.Text.Caption"
                            android:textColor="@color/dc_key_icon"
                            android:textSize="@dimen/_10ssp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:text="@string/typing_url_in"/>
                    </LinearLayout>
                </LinearLayout>
                <ImageView
                    android:layout_gravity="end"
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:src="@drawable/dc_ic_arrow_forward_small"
                    android:importantForAccessibility="no"
                    app:tint="@color/dc_key_icon"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
