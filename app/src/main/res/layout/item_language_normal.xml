<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bg_item_language"
    android:paddingLeft="16dp"
    android:paddingTop="12dp"
    android:paddingRight="16dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:layout_marginVertical="8dp"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/flagMain"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circle"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvLanguageName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:includeFontPadding="false"
        android:layout_weight="1"
        android:layout_marginHorizontal="8dp"
        style="@style/Semibold_14"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imvSelect"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/bg_select"/>
</androidx.appcompat.widget.LinearLayoutCompat>
