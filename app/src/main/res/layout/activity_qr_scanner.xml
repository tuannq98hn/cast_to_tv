<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_qr_scanner_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rlHeader"
        android:background="@color/dc_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_56sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:id="@+id/llBack"
            android:padding="@dimen/_6sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true">
            <ImageView
                android:id="@+id/imvBack"
                android:background="@drawable/dc_bg_key"
                android:padding="@dimen/_9sdp"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:src="@drawable/ic_back_arrow"
                app:tint="@color/dc_text_primary"
                android:layout_centerVertical="true"/>
        </LinearLayout>
        <TextView
            style="@style/DC.Text.Heading"
            android:id="@+id/tvTitleTab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scan_qr"
            android:layout_toRightOf="@+id/llBack"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <com.budiyev.android.codescanner.CodeScannerView
        android:id="@+id/scanner"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:autoFocusButtonVisible="false"
        app:flashButtonVisible="false"
        app:frameCornersCapRounded="true"
        app:frameColor="@color/dc_primary"
        app:frameCornersRadius="16dp"
        app:maskColor="@color/dc_scrim"
        app:frameCornersSize="32dp"
        app:frameVerticalBias="0.35">
        <TextView
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/scanner_hint"
            android:paddingTop="32dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/code_scan_hint"
            android:maxLines="5"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
    </com.budiyev.android.codescanner.CodeScannerView>
</LinearLayout>
