<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_dialog"
    android:padding="@dimen/_16sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_24sdp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialogRate_constraint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialogRate_img">
        <TextView
            android:textSize="@dimen/_15sdp"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/dialogRate_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_5sdp"
            android:layout_marginTop="@dimen/_40sdp"
            android:layout_marginRight="@dimen/_5sdp"
            android:text="@string/title_rate1"
            android:fontFamily="@font/pro_display_bold"
            android:layout_marginHorizontal="@dimen/_5sdp"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/_13sdp"
            android:textColor="@color/color_gray"
            android:gravity="center"
            android:id="@+id/dialogRate_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_12sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginRight="@dimen/_12sdp"
            android:text="@string/des_rate"
            android:layout_marginHorizontal="@dimen/_12sdp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dialogRate_title"/>
        <com.willy.ratingbar.ScaleRatingBar
            android:id="@+id/ratting_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dialogRate_description"
            app:srb_clearRatingEnabled="true"
            app:srb_clickable="true"
            app:srb_drawableEmpty="@drawable/img_star_unfill"
            app:srb_drawableFilled="@drawable/img_star_fill"
            app:srb_isIndicator="false"
            app:srb_minimumStars="1"
            app:srb_numStars="5"
            app:srb_rating="5"
            app:srb_scrollable="true"
            app:srb_starHeight="@dimen/_35sdp"
            app:srb_starPadding="@dimen/_10sdp"
            app:srb_starWidth="@dimen/_35sdp"/>
        <TextView
            android:id="@+id/tv_exit"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_10sdp"
            android:text="@string/maybe_later"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ratting_bar"/>
        <Button
            android:textColor="@color/white"
            android:id="@+id/btnRate"
            android:background="@drawable/bg_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginLeft="@dimen/_20sdp"
            android:layout_marginTop="@dimen/_15sdp"
            android:layout_marginRight="@dimen/_20sdp"
            android:text="@string/rate"
            android:fontFamily="@font/pro_display_bold"
            android:layout_marginHorizontal="@dimen/_20sdp"
            app:layout_constraintTop_toBottomOf="@+id/ratting_bar"/>
        <EditText
            android:textSize="@dimen/_10sdp"
            android:gravity="top"
            android:id="@+id/edt_dialog_rate_input"
            android:background="@drawable/bg_feedback"
            android:padding="@dimen/_5sdp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_80sdp"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginRight="@dimen/_10sdp"
            android:hint="@string/please_leave_a_feedback_to_help_us_improve_product"
            android:layout_marginHorizontal="@dimen/_10sdp"
            app:layout_constraintTop_toBottomOf="@+id/ratting_bar"/>
        <Button
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/dialogRate_submit"
            android:background="@drawable/bg_button"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginLeft="@dimen/_20sdp"
            android:layout_marginTop="@dimen/_15sdp"
            android:layout_marginRight="@dimen/_20sdp"
            android:text="@string/submit"
            android:textAllCaps="true"
            android:fontFamily="@font/pro_display_bold"
            android:layout_marginHorizontal="@dimen/_20sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edt_dialog_rate_input"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/dialogRate_img"
        android:layout_width="@dimen/_184sdp"
        android:layout_height="@dimen/_120sdp"
        android:src="@drawable/imv_empty_rate"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
