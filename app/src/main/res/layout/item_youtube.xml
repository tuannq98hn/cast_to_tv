<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/_16sdp"
    android:paddingTop="@dimen/_8sdp"
    android:paddingRight="@dimen/_16sdp"
    android:paddingBottom="@dimen/_8sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/_16sdp"
    android:paddingVertical="@dimen/_8sdp">
    <com.github.siyamed.shapeimageview.RoundedImageView
        android:id="@+id/imv_itemYoutubeThumbnail"
        android:layout_width="@dimen/_64sdp"
        android:layout_height="@dimen/_64sdp"
        android:src="@drawable/ic_video_default"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:siRadius="@dimen/_10sdp"/>
    <ImageView
        android:id="@+id/imvNoAudio"
        android:visibility="visible"
        android:layout_width="@dimen/_22sdp"
        android:layout_height="@dimen/_14sdp"
        android:src="@drawable/ic_no_audio"
        app:layout_constraintStart_toStartOf="@+id/imv_itemYoutubeThumbnail"
        app:layout_constraintTop_toTopOf="@+id/imv_itemYoutubeThumbnail"/>
    <TextView
        android:textSize="@dimen/_10sdp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_itemYoutubeQuality"
        android:background="@drawable/bg_border_height"
        android:paddingLeft="@dimen/_5sdp"
        android:paddingRight="@dimen/_5sdp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_20sdp"
        android:text="1280p"
        android:paddingHorizontal="@dimen/_5sdp"
        app:layout_constraintBottom_toTopOf="@+id/tv_itemYoutubeName"
        app:layout_constraintLeft_toRightOf="@+id/imv_itemYoutubeThumbnail"
        app:layout_constraintTop_toTopOf="@+id/imv_itemYoutubeThumbnail"/>
    <TextView
        android:textSize="@dimen/_13sdp"
        android:textColor="#323232"
        android:ellipsize="end"
        android:id="@+id/tv_itemYoutubeName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_20sdp"
        android:text="name video"
        android:singleLine="true"
        android:fontFamily="@font/pro_display_regular"
        app:layout_constraintBottom_toBottomOf="@+id/imv_itemYoutubeThumbnail"
        app:layout_constraintLeft_toRightOf="@+id/imv_itemYoutubeThumbnail"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_itemYoutubeQuality"/>
    <TextView
        android:textSize="@dimen/_11sdp"
        android:textColor="#151515"
        android:gravity="center"
        android:id="@+id/tv_itemYoutubeFormat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_16sdp"
        android:text="mp4"
        app:layout_constraintBottom_toTopOf="@+id/tv_itemYoutubeName"
        app:layout_constraintLeft_toRightOf="@+id/tv_itemYoutubeQuality"
        app:layout_constraintTop_toTopOf="@+id/imv_itemYoutubeThumbnail"/>
</androidx.constraintlayout.widget.ConstraintLayout>
