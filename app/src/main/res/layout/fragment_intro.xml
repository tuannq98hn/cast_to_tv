<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/img_intro"
            android:background="@drawable/dc_bg_glass_card"
            android:padding="@dimen/_12sdp"
            android:layout_width="@dimen/_260sdp"
            android:layout_height="@dimen/_232sdp"
            android:src="@drawable/bg_intro_1"/>
        <TextView
            style="@style/DC.Text"
            android:textSize="@dimen/_22ssp"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_30sdp"
            android:layout_marginTop="@dimen/_32sdp"
            android:layout_marginRight="@dimen/_30sdp"
            android:text="@string/title_1"
            android:fontFamily="@font/pro_display_bold"
            android:layout_marginHorizontal="@dimen/_30sdp"/>
        <TextView
            style="@style/DC.Text.Body"
            android:textColor="@color/dc_text_muted"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_40sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginRight="@dimen/_40sdp"
            android:text="@string/guide_1"
            android:fontFamily="@font/pro_display_medium"
            android:layout_marginHorizontal="@dimen/_40sdp"/>
    </LinearLayout>
</RelativeLayout>
