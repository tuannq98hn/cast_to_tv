<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/scrollView"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayout10"
                android:background="@drawable/img_halloween_main"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="1.36:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/testing_1_close"
                    android:background="@drawable/ripple_effect_exit"
                    android:padding="@dimen/_4sdp"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_marginLeft="@dimen/_16sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginRight="@dimen/_16sdp"
                    android:src="@drawable/ic_close_ads"
                    android:layout_alignParentRight="true"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayout5"
                android:background="@color/color_halloween"
                android:paddingTop="@dimen/_24sdp"
                android:paddingBottom="@dimen/_24sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_minus30sdp"
                android:paddingVertical="@dimen/_24sdp"
                app:layout_constraintTop_toBottomOf="@+id/constraintLayout10">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_16sdp"
                    android:layout_marginRight="@dimen/_16sdp"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:orientation="vertical"
                            android:background="@drawable/ic_frame_halloween_content"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginLeft="20dp"
                            android:layout_marginRight="20dp"
                            android:layout_marginHorizontal="20dp"
                            app:layout_constraintDimensionRatio="1.4:1"
                            app:layout_constraintTop_toTopOf="parent">
                            <TextView
                                android:textSize="@dimen/_28sdp"
                                android:textColor="@color/white"
                                android:layout_gravity="center"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_20sdp"
                                android:text="@string/unlimited_access"
                                android:fontFamily="@font/pro_display_bold"/>
                            <LinearLayout
                                android:layout_gravity="center"
                                android:orientation="vertical"
                                android:id="@+id/linearLayout25"
                                android:paddingLeft="@dimen/_16sdp"
                                android:paddingRight="@dimen/_16sdp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_8sdp"
                                android:paddingHorizontal="@dimen/_16sdp"
                                app:layout_constraintTop_toTopOf="parent">
                                <LinearLayout
                                    android:gravity="center"
                                    android:orientation="horizontal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">
                                    <ImageView
                                        android:layout_width="@dimen/_24sdp"
                                        android:layout_height="@dimen/_24sdp"
                                        android:src="@drawable/ic_mirror_setting"/>
                                    <TextView
                                        android:textSize="@dimen/_13sdp"
                                        android:textColor="@color/white"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/ultimate_screen_mirroring"
                                        android:fontFamily="@font/pro_display_regular"
                                        android:layout_marginStart="@dimen/_6sdp"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:gravity="center"
                                    android:orientation="horizontal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_8sdp">
                                    <ImageView
                                        android:layout_width="@dimen/_24sdp"
                                        android:layout_height="@dimen/_24sdp"
                                        android:src="@drawable/ic_total_ads"/>
                                    <TextView
                                        android:textSize="@dimen/_13sdp"
                                        android:textColor="@color/white"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/totally_ad_free"
                                        android:fontFamily="@font/pro_display_regular"
                                        android:layout_marginStart="@dimen/_6sdp"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:gravity="center"
                                    android:orientation="horizontal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_8sdp">
                                    <ImageView
                                        android:layout_width="@dimen/_24sdp"
                                        android:layout_height="@dimen/_24sdp"
                                        android:src="@drawable/ic_all_feature"/>
                                    <TextView
                                        android:textSize="@dimen/_13sdp"
                                        android:textColor="@color/white"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/all_updates_amp_new_feature"
                                        android:fontFamily="@font/pro_display_regular"
                                        android:layout_marginStart="@dimen/_6sdp"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:gravity="center"
                                    android:orientation="horizontal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_8sdp">
                                    <ImageView
                                        android:layout_width="@dimen/_24sdp"
                                        android:layout_height="@dimen/_24sdp"
                                        android:src="@drawable/ic_quality"/>
                                    <TextView
                                        android:textSize="@dimen/_13sdp"
                                        android:textColor="@color/white"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/improved_streaming_quality"
                                        android:fontFamily="@font/pro_display_regular"
                                        android:layout_marginStart="@dimen/_6sdp"/>
                                </LinearLayout>
                            </LinearLayout>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_16sdp">
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:orientation="vertical"
                            android:id="@+id/ll_monthly"
                            android:background="@drawable/bg_price_premium_halloween"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/_6sdp">
                            <TextView
                                android:textSize="@dimen/_16sdp"
                                android:textColor="@color/white"
                                android:gravity="center"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_6sdp"
                                android:text="@string/monthly"
                                android:fontFamily="@font/pro_display_semibold"/>
                            <androidx.appcompat.widget.LinearLayoutCompat
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:textSize="@dimen/_16sdp"
                                    android:textColor="@color/color_halloween_orange"
                                    android:gravity="center"
                                    android:id="@+id/txt_monthly_price"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="@dimen/_8sdp"
                                    android:fontFamily="@font/pro_display_semibold"
                                    android:layout_marginEnd="@dimen/_6sdp"/>
                                <TextView
                                    android:textSize="@dimen/_12sdp"
                                    android:textStyle="italic"
                                    android:textColor="@color/white"
                                    android:gravity="center"
                                    android:id="@+id/txt_monthly_high"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="@dimen/_8sdp"
                                    android:fontFamily="@font/pro_display_semibold"/>
                            </androidx.appcompat.widget.LinearLayoutCompat>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:orientation="vertical"
                            android:id="@+id/ll_lifetime"
                            android:background="@drawable/bg_price_premium_halloween"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/_6sdp">
                            <TextView
                                android:textSize="@dimen/_16sdp"
                                android:textColor="@color/white"
                                android:gravity="center"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_6sdp"
                                android:text="@string/life_time"
                                android:fontFamily="@font/pro_display_semibold"/>
                            <androidx.appcompat.widget.LinearLayoutCompat
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:textSize="@dimen/_16sdp"
                                    android:textColor="@color/color_halloween_orange"
                                    android:gravity="center"
                                    android:id="@+id/txt_life_price"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="@dimen/_8sdp"
                                    android:fontFamily="@font/pro_display_semibold"
                                    android:layout_marginEnd="@dimen/_6sdp"/>
                                <TextView
                                    android:textSize="@dimen/_12sdp"
                                    android:textStyle="italic"
                                    android:textColor="@color/white"
                                    android:gravity="center"
                                    android:id="@+id/txt_life_high"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="@dimen/_8sdp"
                                    android:fontFamily="@font/pro_display_semibold"/>
                            </androidx.appcompat.widget.LinearLayoutCompat>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="24dp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/btn_billing"
                        android:background="@drawable/bg_btn_halloween"
                        android:paddingTop="@dimen/_10sdp"
                        android:paddingBottom="@dimen/_8sdp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:text="@string/start_trial"
                        android:fontFamily="@font/halloween"/>
                    <TextView
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/txt_price"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:text="@string/text_free_trial"
                        android:fontFamily="@font/pro_display_medium"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/linearLayout19"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_15sdp"
                        app:layout_constraintTop_toBottomOf="@+id/linearLayout20">
                        <TextView
                            android:textSize="@dimen/_13sdp"
                            android:textColor="@color/color_halloween_accent"
                            android:layout_gravity="center_horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/subscription_terms"
                            android:fontFamily="@font/pro_display_bold"/>
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_22sdp"
                            android:layout_marginTop="@dimen/_10sdp">
                            <TextView
                                android:textSize="@dimen/_12sdp"
                                android:textColor="@color/color_halloween_accent"
                                android:gravity="center"
                                android:layout_gravity="center_horizontal"
                                android:id="@+id/tvTerms"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:text="@string/terms_amp_conditions"
                                android:layout_weight="1"
                                android:fontFamily="@font/pro_display_medium"
                                android:textAlignment="center"/>
                            <View
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold"
                                android:background="@color/text_default"
                                android:layout_width="1dp"
                                android:layout_height="@dimen/_22sdp"
                                android:text="|"/>
                            <TextView
                                android:textSize="@dimen/_12sdp"
                                android:textColor="@color/color_halloween_accent"
                                android:gravity="center"
                                android:id="@+id/tvPolicy"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:text="@string/privacy_policy"
                                android:layout_weight="1"
                                android:fontFamily="@font/pro_display_medium"
                                android:textAlignment="center"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="@dimen/_11sdp"
                            android:textColor="@color/color_halloween_accent"
                            android:id="@+id/tvMessage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:layout_marginBottom="@dimen/_15sdp"
                            android:text="@string/txt_message_iap_week"
                            android:fontFamily="@font/pro_display_regular"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
