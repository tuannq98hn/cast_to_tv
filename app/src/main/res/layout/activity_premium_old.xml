<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <VideoView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1.2:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/imvClose"
            android:background="@drawable/ripple_effect_exit"
            android:padding="@dimen/_4sdp"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:layout_margin="@dimen/_16sdp"
            android:src="@drawable/ic_close_ads"
            android:layout_alignParentEnd="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:behavior_hideable="false"
        app:layout_behavior="@string/bottom_sheet_behavior">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:background="@drawable/bg_bottom_sheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/_18sdp"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:text="@string/unlock_all_features_with_pro"
                android:fontFamily="@font/pro_display_bold"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="@dimen/_28sdp"
                        android:layout_height="@dimen/_28sdp"
                        android:src="@drawable/ic_screen_mirror_iap"/>
                    <TextView
                        android:textSize="@dimen/_14sdp"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ultimate_screen_mirroring"
                        android:fontFamily="@font/pro_display_medium"
                        android:layout_marginStart="@dimen/_6sdp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp">
                    <ImageView
                        android:layout_width="@dimen/_28sdp"
                        android:layout_height="@dimen/_28sdp"
                        android:src="@drawable/ic_remove_ads_iap"/>
                    <TextView
                        android:textSize="@dimen/_14sdp"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/remove_ads_in_app"
                        android:fontFamily="@font/pro_display_medium"
                        android:layout_marginStart="@dimen/_6sdp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp">
                    <ImageView
                        android:layout_width="@dimen/_28sdp"
                        android:layout_height="@dimen/_28sdp"
                        android:src="@drawable/ic_quality_iap"/>
                    <TextView
                        android:textSize="@dimen/_14sdp"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/improved_streaming_quality"
                        android:fontFamily="@font/pro_display_medium"
                        android:layout_marginStart="@dimen/_6sdp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp">
                    <ImageView
                        android:layout_width="@dimen/_28sdp"
                        android:layout_height="@dimen/_28sdp"
                        android:src="@drawable/ic_new_feature_iap"/>
                    <TextView
                        android:textSize="@dimen/_14sdp"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/all_updates_amp_new_feature"
                        android:fontFamily="@font/pro_display_medium"
                        android:layout_marginStart="@dimen/_6sdp"/>
                </LinearLayout>
            </LinearLayout>
            <com.casttotv.screen.mirroring.ui.activities.purchase.expandablelayout.ExpandableLayout
                android:id="@+id/expandable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                app:expandable_animation="accelerate"
                app:expandable_duration="400"
                app:expandable_isExpanded="false"
                app:expandable_parentLayout="@layout/layout_text_options"
                app:expandable_secondLayout="@layout/layout_options"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp">
                <TextView
                    android:textSize="@dimen/_11sdp"
                    android:textColor="#202020"
                    android:id="@+id/tvDisplayPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:text="@string/enjoy_full_access_only"
                    android:fontFamily="@font/pro_display_medium"
                    android:layout_marginStart="@dimen/_2sdp"
                    app:layout_constraintStart_toStartOf="parent"/>
                <TextView
                    android:textSize="@dimen/_11sdp"
                    android:textColor="#4d72f5"
                    android:id="@+id/testing_1_button_year_price"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/s_year"
                    android:fontFamily="@font/pro_display_medium"
                    android:layout_marginStart="2dp"
                    app:layout_constraintStart_toEndOf="@+id/tvDisplayPrice"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.cardview.widget.CardView
                android:id="@+id/cardViewPremium"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_56sdp"
                android:layout_marginLeft="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:layout_marginRight="@dimen/_16sdp"
                android:layout_marginHorizontal="@dimen/_16sdp"
                app:cardCornerRadius="@dimen/_30sdp">
                <RelativeLayout
                    android:background="@drawable/bg_button_premium_on"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_56sdp">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/testing_1_button_year"
                        android:paddingLeft="@dimen/_12sdp"
                        android:paddingRight="@dimen/_12sdp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="@dimen/_12sdp">
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/linearLayout13"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <TextView
                                android:textSize="@dimen/_18sdp"
                                android:textColor="@color/white"
                                android:id="@+id/tvTitleButtonOne"
                                android:focusable="false"
                                android:clickable="false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/start_with_full_access"
                                android:fontFamily="@font/pro_display_bold"
                                android:textAlignment="center"/>
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <View
                        android:id="@+id/shine"
                        android:background="@drawable/img_view_load"
                        android:visibility="visible"
                        android:layout_width="@dimen/_64sdp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/_minus30sdp"
                        app:layout_constraintStart_toStartOf="parent"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="@dimen/_14sdp"
                android:textColor="@color/black"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:text="@string/subscription_terms"
                android:fontFamily="@font/pro_display_medium"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_22sdp"
                android:layout_marginTop="@dimen/_10sdp">
                <TextView
                    android:textSize="@dimen/_13sdp"
                    android:textColor="@color/color_main"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/tvTerms"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/terms_amp_conditions"
                    android:layout_weight="1"
                    android:fontFamily="@font/pro_display_medium"
                    android:textAlignment="center"/>
                <View
                    android:textStyle="bold"
                    android:background="@color/color_main"
                    android:layout_width="1dp"
                    android:layout_height="@dimen/_20sdp"
                    android:text="|"/>
                <TextView
                    android:textSize="@dimen/_13sdp"
                    android:textColor="@color/color_main"
                    android:gravity="center"
                    android:id="@+id/tvPolicy"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/privacy_policy"
                    android:layout_weight="1"
                    android:fontFamily="@font/pro_display_medium"
                    android:textAlignment="center"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/_11sdp"
                android:textColor="@color/color_default"
                android:id="@+id/tvMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginRight="@dimen/_16sdp"
                android:layout_marginBottom="@dimen/_64sdp"
                android:text="@string/txt_iap_description"
                android:fontFamily="@font/pro_display_medium"
                android:layout_marginHorizontal="@dimen/_16sdp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
