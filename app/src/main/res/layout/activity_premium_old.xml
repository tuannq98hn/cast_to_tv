<?xml version="1.0" encoding="utf-8"?>
<!-- Dark Cinema "PRO Upgrade" (Stitch "PRO Upgrade (Dark Cinema)"). Animations (dot pulse, ping, CTA shimmer) run in PurchaseActivity. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/dc_bg_ambient_premium"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:fillViewport="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <!-- "Premium" chip with pulsing dot (decoration) -->
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/dc_bg_glass_pill"
                android:paddingHorizontal="@dimen/_9sdp"
                android:paddingVertical="@dimen/_4sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_16sdp"
                android:layout_gravity="start"
                android:layout_marginTop="@dimen/_22sdp">
                <View
                    android:id="@+id/premiumDot"
                    android:background="@drawable/dc_bg_pulse_dot"
                    android:layout_width="@dimen/_6sdp"
                    android:layout_height="@dimen/_6sdp"/>
                <TextView
                    style="@style/DC.Text.Label"
                    android:textColor="@color/dc_primary_soft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:text="@string/get_premium"/>
            </LinearLayout>
            <!-- Device stage (Stitch hero): TV with pinging wifi, phone with a cast widget, dashed beam between them -->
            <FrameLayout
                android:layout_width="@dimen/_246sdp"
                android:layout_height="@dimen/_150sdp"
                android:layout_marginTop="@dimen/_12sdp">
                <FrameLayout
                    android:background="@drawable/dc_bg_pro_tv"
                    android:padding="@dimen/_5sdp"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="@dimen/_197sdp"
                    android:layout_height="@dimen/_111sdp"
                    android:layout_marginTop="@dimen/_14sdp">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/dc_bg_pro_tv_screen"
                        android:clipChildren="false"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <FrameLayout
                            android:clipChildren="false"
                            android:layout_width="@dimen/_37sdp"
                            android:layout_height="@dimen/_37sdp">
                            <View
                                android:id="@+id/heroPing"
                                android:background="@drawable/dc_bg_ping"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>
                            <ImageView
                                android:layout_gravity="center"
                                android:layout_width="@dimen/_25sdp"
                                android:layout_height="@dimen/_25sdp"
                                android:src="@drawable/dc_ic_wifi_signal"
                                android:importantForAccessibility="no"
                                app:tint="@color/dc_primary_soft"/>
                        </FrameLayout>
                        <TextView
                            style="@style/DC.Text"
                            android:fontFamily="@font/pro_display_bold"
                            android:letterSpacing="0.1"
                            android:textAllCaps="true"
                            android:textColor="#a5f3fc"
                            android:textSize="@dimen/_8ssp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_3sdp"
                            android:text="@string/text_connected"/>
                    </LinearLayout>
                </FrameLayout>
                <View
                    android:background="@drawable/dc_bg_pro_stand"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="@dimen/_62sdp"
                    android:layout_height="3dp"
                    android:layout_marginTop="@dimen/_124sdp"/>
                <ImageView
                    android:layout_gravity="bottom|end"
                    android:layout_width="@dimen/_49sdp"
                    android:layout_height="@dimen/_37sdp"
                    android:layout_marginEnd="@dimen/_74sdp"
                    android:layout_marginBottom="@dimen/_31sdp"
                    android:src="@drawable/dc_pro_wave"
                    android:importantForAccessibility="no"/>
                <FrameLayout
                    android:background="@drawable/dc_bg_pro_phone"
                    android:padding="@dimen/_3sdp"
                    android:layout_gravity="bottom|end"
                    android:layout_width="@dimen/_74sdp"
                    android:layout_height="@dimen/_123sdp"
                    android:layout_marginEnd="@dimen/_12sdp">
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:background="@drawable/dc_bg_pro_phone_screen"
                        android:padding="@dimen/_5sdp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <View
                            android:background="@drawable/dc_bg_mirror_bar"
                            android:backgroundTint="#334155"
                            android:layout_width="@dimen/_25sdp"
                            android:layout_height="@dimen/_3sdp"/>
                        <LinearLayout
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:background="@drawable/dc_bg_pro_widget"
                            android:padding="@dimen/_3sdp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_9sdp">
                            <ImageView
                                android:background="@drawable/dc_bg_pro_play"
                                android:padding="@dimen/_4sdp"
                                android:layout_width="@dimen/_18sdp"
                                android:layout_height="@dimen/_18sdp"
                                android:src="@drawable/dc_ic_play_arrow"
                                android:importantForAccessibility="no"
                                app:tint="@color/dc_primary_soft"/>
                            <View
                                android:background="@drawable/dc_bg_mirror_bar"
                                android:backgroundTint="#6622d3ee"
                                android:layout_width="@dimen/_31sdp"
                                android:layout_height="@dimen/_3sdp"
                                android:layout_marginTop="@dimen/_3sdp"/>
                        </LinearLayout>
                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_12sdp"
                            android:layout_marginBottom="@dimen/_2sdp">
                            <View
                                android:background="@drawable/dc_bg_pro_key_indigo"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginEnd="@dimen/_2sdp"/>
                            <View
                                android:background="@drawable/dc_bg_pro_key_cyan"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/_2sdp"/>
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>
            <TextView
                style="@style/DC.Text.Title"
                android:id="@+id/txtProTitle"
                android:textSize="@dimen/_20ssp"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_20sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:text="@string/unlock_all_features_with_pro"/>
            <TextView
                style="@style/DC.Text.Caption"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_32sdp"
                android:layout_marginTop="@dimen/_6sdp"
                android:layout_marginBottom="@dimen/_20sdp"
                android:text="@string/to_fulfill_your_uninterrupted_experience"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:background="@drawable/dc_bg_sheet"
                android:paddingHorizontal="@dimen/_16sdp"
                android:paddingTop="@dimen/_12sdp"
                android:paddingBottom="@dimen/_24sdp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <View
                    android:background="@drawable/dc_bg_chip"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_3sdp"
                    android:layout_marginBottom="@dimen/_16sdp"/>
                <include layout="@layout/layout_pro_features"/>
                <com.casttotv.screen.mirroring.ui.activities.purchase.expandablelayout.ExpandableLayout
                    android:id="@+id/expandable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_16sdp"
                    app:expandable_animation="accelerate"
                    app:expandable_duration="400"
                    app:expandable_isExpanded="false"
                    app:expandable_showSpinner="false"
                    app:expandable_parentLayout="@layout/layout_text_options"
                    app:expandable_secondLayout="@layout/layout_options"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp">
                    <TextView
                        style="@style/DC.Text.Body"
                        android:id="@+id/tvDisplayPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/enjoy_full_access_only"/>
                    <TextView
                        style="@style/DC.Text.Body"
                        android:textColor="@color/dc_primary_soft"
                        android:fontFamily="@font/pro_display_bold"
                        android:id="@+id/testing_1_button_year_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_2sdp"
                        android:text="@string/s_year"/>
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/testing_1_button_year"
                    android:background="@drawable/dc_bg_cta_gradient"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_48sdp"
                    android:layout_marginTop="@dimen/_12sdp">
                    <View
                        android:id="@+id/ctaShimmer"
                        android:background="@drawable/dc_shimmer_sweep"
                        android:visibility="invisible"
                        android:layout_width="@dimen/_120sdp"
                        android:layout_height="match_parent"/>
                    <TextView
                        style="@style/DC.Text.Button"
                        android:textColor="@color/dc_text_primary"
                        android:textAllCaps="true"
                        android:id="@+id/tvTitleButtonOne"
                        android:focusable="false"
                        android:clickable="false"
                        android:drawableEnd="@drawable/dc_ic_arrow_forward"
                        android:drawablePadding="@dimen/_8sdp"
                        android:drawableTint="@color/dc_text_primary"
                        android:fontFamily="@font/pro_display_bold"
                        android:letterSpacing="0.03"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/start_with_full_access"/>
                </FrameLayout>
                <TextView
                    style="@style/DC.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:text="@string/subscription_terms"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp">
                    <TextView
                        style="@style/DC.Text.Caption"
                        android:id="@+id/tvTerms"
                        android:textSize="@dimen/_10ssp"
                        android:maxLines="1"
                        android:padding="@dimen/_4sdp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/terms_amp_conditions"/>
                    <TextView
                        style="@style/DC.Text.Caption"
                        android:textColor="@color/dc_text_subtle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dc_dot"/>
                    <TextView
                        style="@style/DC.Text.Caption"
                        android:id="@+id/tvPolicy"
                        android:textSize="@dimen/_10ssp"
                        android:maxLines="1"
                        android:padding="@dimen/_4sdp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/privacy_policy"/>
                    <TextView
                        style="@style/DC.Text.Caption"
                        android:textColor="@color/dc_text_subtle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dc_dot"/>
                    <TextView
                        style="@style/DC.Text.Caption"
                        android:id="@+id/tvRestore"
                        android:textSize="@dimen/_10ssp"
                        android:maxLines="1"
                        android:padding="@dimen/_4sdp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/restore_purchase"/>
                </LinearLayout>
                <TextView
                    style="@style/DC.Text.Caption"
                    android:textColor="@color/dc_text_subtle"
                    android:id="@+id/tvMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:text="@string/txt_iap_description"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <ImageView
        android:id="@+id/imvClose"
        android:background="@drawable/dc_bg_glass_pill"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/_7sdp"
        android:layout_gravity="end"
        android:layout_width="@dimen/_28sdp"
        android:layout_height="@dimen/_28sdp"
        android:layout_marginTop="@dimen/_18sdp"
        android:layout_marginEnd="@dimen/_16sdp"
        android:src="@drawable/dc_ic_close"
        android:contentDescription="@string/close"
        app:tint="@color/dc_key_icon"/>
</FrameLayout>
