<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="@dimen/_10sdp"
        android:paddingTop="@dimen/_6sdp"
        android:paddingRight="@dimen/_10sdp"
        android:paddingBottom="@dimen/_6sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_10sdp"
        android:paddingVertical="@dimen/_6sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="@color/dc_text_muted"
            android:id="@+id/tvDate"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_10sdp"
            android:text="@string/app_name"/>
        <RelativeLayout
            android:orientation="horizontal"
            android:background="@drawable/bg_item_web_cast"
            android:padding="@dimen/_10sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/imvThumb"
                android:background="@drawable/dc_bg_device_icon"
                android:padding="@dimen/_6sdp"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:src="@drawable/ic_google_web"
                android:layout_centerVertical="true"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_15sdp"
                android:layout_marginRight="@dimen/_15sdp"
                android:layout_toLeftOf="@+id/imvRemove"
                android:layout_toRightOf="@+id/imvThumb"
                android:layout_centerVertical="true"
                android:layout_marginHorizontal="@dimen/_15sdp">
                <TextView
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/dc_text_primary"
                    android:ellipsize="end"
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:lines="1"
                    android:fontFamily="@font/pro_display_medium"/>
                <TextView
                    android:textSize="@dimen/_10sdp"
                    android:textColor="@color/dc_text_muted"
                    android:ellipsize="end"
                    android:id="@+id/tvLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:text="@string/app_name"
                    android:lines="1"
                    android:fontFamily="@font/pro_display_medium"/>
            </LinearLayout>
            <ImageButton
                android:id="@+id/imvRemove"
                android:background="@drawable/ic_close"
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:backgroundTint="@color/dc_text_muted"/>
        </RelativeLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
