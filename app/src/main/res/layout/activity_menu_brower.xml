<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/include7"
        layout="@layout/item_header"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/_15sdp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/include7">
        <TextView
            android:textSize="@dimen/_13sdp"
            android:textColor="@color/color_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connected_successfully"
            android:fontFamily="@font/pro_display_medium"/>
        <TextView
            android:textSize="@dimen/_13sdp"
            android:textColor="@color/color_gray9"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:text="@string/title_connect_web"
            android:fontFamily="@font/pro_display_medium"/>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:src="@drawable/img_webcast_tv"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout9"/>
        <Button
            android:textSize="@dimen/_13sdp"
            android:textColor="@color/white"
            android:background="@drawable/bg_btn_refresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:text="@string/local_resource"
            android:textAllCaps="false"
            android:fontFamily="@font/roboto_regular"/>
        <Button
            android:textSize="@dimen/_13sdp"
            android:textColor="@color/white"
            android:background="@drawable/bg_btn_refresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:text="@string/web_resource"
            android:textAllCaps="false"
            android:fontFamily="@font/roboto_regular"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
