<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_mirror_direct_0"
    android:background="@color/white"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/rl_itemHeader"
            android:padding="@dimen/_5sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/imv_back"
                android:background="@drawable/ripple_effect_exit"
                android:padding="@dimen/_7sdp"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:src="@drawable/ic_back_arrow"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="@dimen/_17sdp"
                android:textColor="@color/color_text_new"
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_5sdp"
                android:layout_marginRight="@dimen/_5sdp"
                android:text="@string/direct_mirror"
                android:lines="1"
                android:layout_centerInParent="true"
                android:fontFamily="@font/pro_display_bold"
                android:layout_toEndOf="@+id/imv_back"
                android:layout_marginHorizontal="@dimen/_5sdp"/>
        </RelativeLayout>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/anim_cast"
            android:layout_width="@dimen/_200sdp"
            android:layout_height="@dimen/_200sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rl_itemHeader"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/anim_mirror_direct"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_ins"
            android:background="@drawable/bg_item_language"
            android:paddingTop="@dimen/_16sdp"
            android:paddingBottom="@dimen/_16sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginRight="@dimen/_16sdp"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:paddingVertical="@dimen/_16sdp"
            app:layout_constraintTop_toBottomOf="@+id/anim_cast">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/linearLayout9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/include6">
                <TextView
                    android:textSize="@dimen/_14sdp"
                    android:textColor="@color/color_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_12sdp"
                    android:layout_marginRight="@dimen/_12sdp"
                    android:text="@string/txt_cast_direct"
                    android:fontFamily="@font/pro_display_regular"
                    android:layout_marginHorizontal="@dimen/_12sdp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/linearLayout10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                app:layout_constraintTop_toBottomOf="@+id/include6">
                <TextView
                    android:textSize="@dimen/_14sdp"
                    android:textColor="@color/color_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_12sdp"
                    android:layout_marginRight="@dimen/_12sdp"
                    android:text="@string/txt_cast_direct_2"
                    android:fontFamily="@font/pro_display_regular"
                    android:layout_marginHorizontal="@dimen/_12sdp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/linearLayout11"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                app:layout_constraintTop_toBottomOf="@+id/include6">
                <TextView
                    android:textSize="@dimen/_14sdp"
                    android:textColor="@color/color_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_12sdp"
                    android:layout_marginRight="@dimen/_12sdp"
                    android:text="@string/txt_cast_direct_3"
                    android:fontFamily="@font/custom_font"
                    android:layout_marginHorizontal="@dimen/_12sdp"/>
            </LinearLayout>
        </LinearLayout>
        <Button
            android:textSize="@dimen/_16sdp"
            android:textColor="@color/white"
            android:id="@+id/btn_start"
            android:background="@drawable/bg_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginLeft="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_50sdp"
            android:layout_marginRight="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_24sdp"
            android:text="@string/start"
            android:layout_alignParentBottom="true"
            android:fontFamily="@font/pro_display_bold"
            android:layout_marginHorizontal="@dimen/_16sdp"
            app:layout_constraintBottom_toTopOf="@+id/layoutAds"
            app:layout_constraintTop_toBottomOf="@+id/ll_ins"
            app:layout_constraintVertical_bias="1"/>
        <RelativeLayout
            android:id="@+id/layoutAds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent">
            <FrameLayout android:visibility="gone"
                android:id="@+id/nativeAds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"/>
            <FrameLayout
                android:id="@+id/bannerMirrorDirect"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
