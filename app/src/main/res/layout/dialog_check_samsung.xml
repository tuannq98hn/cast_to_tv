<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_dialog"
        android:padding="@dimen/_15sdp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/_25sdp">
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/imvClose"
            android:padding="@dimen/_2sdp"
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:src="@drawable/ic_close_black"/>
        <TextView
            android:textSize="@dimen/_13sdp"
            android:textColor="@color/textColor"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/we_ve_sent_a_connection_request_to_your_tv"
            android:layout_below="@+id/imvClose"
            android:layout_centerHorizontal="true"
            android:fontFamily="@font/pro_display_medium"/>
        <TextView
            android:textSize="@dimen/_10sdp"
            android:textColor="@color/textColor"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_14sdp"
            android:text="@string/des_check_ss"
            android:layout_below="@+id/imvClose"
            android:fontFamily="@font/pro_display_regular"/>
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/_130sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:src="@drawable/imv_allow"/>
        <TextView
            android:textSize="@dimen/_10sdp"
            android:textColor="@color/textColor"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_20sdp"
            android:layout_marginTop="@dimen/_14sdp"
            android:layout_marginRight="@dimen/_20sdp"
            android:layout_marginBottom="@dimen/_30sdp"
            android:text="@string/about_20s"
            android:layout_below="@+id/imvClose"
            android:fontFamily="@font/pro_display_regular"
            android:layout_marginHorizontal="@dimen/_20sdp"/>
    </LinearLayout>
</LinearLayout>
