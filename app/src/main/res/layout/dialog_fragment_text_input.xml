<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_remote"
    android:padding="@dimen/_20sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_20sdp">
    <TextView
        android:textSize="@dimen/_14sdp"
        android:textColor="@color/white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/keyboard_input"
        android:fontFamily="@font/pro_display_medium"/>
    <EditText
        android:textSize="@dimen/_12sdp"
        android:textColor="@color/white"
        android:textColorHint="@color/white"
        android:id="@+id/text_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:hint="Type a word"
        android:fontFamily="@font/pro_display_regular"
        android:backgroundTint="@color/color_default"/>
    <TextView
        android:textSize="@dimen/_11sdp"
        android:textStyle="italic"
        android:textColor="@color/white"
        android:id="@+id/tvTutorial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:text="@string/view_tutorial_video_here"
        android:fontFamily="@font/pro_display_regular"
        android:layout_marginVertical="@dimen/_10sdp"/>
    <LinearLayout
        android:gravity="end"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp">
        <Button
            android:textSize="@dimen/_14sdp"
            android:textColor="@color/white"
            android:layout_gravity="end"
            android:id="@+id/btnClose"
            android:background="@drawable/bg_button_cancel_remote"
            android:layout_width="@dimen/_112sdp"
            android:layout_height="@dimen/_40sdp"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:fontFamily="@font/pro_display_medium"/>
    </LinearLayout>
</LinearLayout>
