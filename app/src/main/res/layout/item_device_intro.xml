<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bg_border12_secondary"
    android:paddingLeft="16dp"
    android:paddingTop="@dimen/_12sdp"
    android:paddingRight="16dp"
    android:paddingBottom="@dimen/_12sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_8sdp"
    android:layout_centerVertical="true"
    android:paddingHorizontal="16dp"
    android:paddingVertical="@dimen/_12sdp">
    <ImageView
        android:id="@+id/imvBranchTV"
        android:layout_width="@dimen/_44sdp"
        android:layout_height="@dimen/_24sdp"
        android:src="@drawable/ic_connected_home"
        android:adjustViewBounds="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_16sdp"
        android:layout_marginRight="@dimen/_16sdp"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/_16sdp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/black"
            android:ellipsize="marquee"
            android:id="@+id/tvNameDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:singleLine="true"
            android:fontFamily="@font/pro_display_semibold"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_default"
            android:ellipsize="marquee"
            android:id="@+id/text_device_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:singleLine="true"
            android:fontFamily="@font/pro_display_regular"/>
    </LinearLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
