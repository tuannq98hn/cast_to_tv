<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@color/transparent"
    android:paddingLeft="@dimen/_24sdp"
    android:paddingRight="@dimen/_24sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/_24sdp">
    <RelativeLayout
        android:background="@drawable/dc_bg_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/_13sdp"
            android:textColor="@color/dc_text_primary"
            android:gravity="center"
            android:id="@+id/tv_connectFireTV"
            android:paddingLeft="@dimen/_10sdp"
            android:paddingRight="@dimen/_10sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_18sdp"
            android:text="Connecting to 192. 168.89.146:5555"
            android:fontFamily="@font/pro_display_medium"
            android:paddingHorizontal="@dimen/_10sdp"/>
        <ProgressBar
            android:indeterminateTint="@color/dc_primary"
            android:id="@+id/progressBar"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_marginTop="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_16sdp"
            android:layout_below="@+id/tv_connectFireTV"
            android:layout_centerHorizontal="true"
            android:layout_marginVertical="@dimen/_16sdp"/>
        <TextView
            android:textSize="@dimen/_10sdp"
            android:id="@+id/text1"
            android:textColor="@color/dc_text_muted"
            android:paddingLeft="@dimen/_10sdp"
            android:paddingRight="@dimen/_10sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/please_make_sure_the_target_device_has_network_adb_enabled"
            android:layout_below="@+id/progressBar"
            android:paddingHorizontal="@dimen/_10sdp"/>
        <TextView
            android:textSize="@dimen/_10sdp"
            android:id="@+id/text2"
            android:textColor="@color/dc_text_muted"
            android:paddingLeft="@dimen/_10sdp"
            android:paddingRight="@dimen/_10sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/you_may_need_to_accept_a_prompt_on_the_target_device_if_you_are_connecting_to_it_for_the_first_time_from_this_device"
            android:layout_below="@+id/text1"
            android:paddingHorizontal="@dimen/_10sdp"/>
        <TextView
            android:textColor="@color/dc_primary_soft"
            android:id="@+id/tv_cancel"
            android:padding="@dimen/_10sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginBottom="@dimen/_8sdp"
            android:text="@string/cancel_dialog"
            android:layout_below="@+id/text2"
            android:layout_centerHorizontal="true"
            android:fontFamily="@font/pro_display_medium"
            android:layout_marginVertical="@dimen/_8sdp"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
