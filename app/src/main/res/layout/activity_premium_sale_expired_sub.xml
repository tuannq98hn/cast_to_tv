<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/scrollView"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayout10"
                android:background="@color/color_main"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="0.8:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lav_guide_screen_mirroring"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:scaleType="centerInside"
                    android:layout_centerInParent="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:lottie_autoPlay="true"
                    app:lottie_fileName="badge_sale.json"
                    app:lottie_loop="true"/>
                <ImageView
                    android:id="@+id/testing_1_close"
                    android:background="@drawable/ripple_effect_exit"
                    android:padding="@dimen/_4sdp"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_marginLeft="@dimen/_16sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginRight="@dimen/_16sdp"
                    android:src="@drawable/ic_close_ads"
                    android:layout_alignParentRight="true"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayout5"
                android:background="@drawable/bg_bottom_sheet"
                android:paddingTop="@dimen/_24sdp"
                android:paddingBottom="@dimen/_24sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_minus30sdp"
                android:paddingVertical="@dimen/_24sdp"
                app:layout_constraintTop_toBottomOf="@+id/constraintLayout10">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_16sdp"
                    android:layout_marginRight="@dimen/_16sdp"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="@dimen/_28sdp"
                        android:textColor="@color/black"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/welcome_back"
                        android:fontFamily="@font/pro_display_bold"/>
                    <TextView
                        android:textSize="@dimen/_16sdp"
                        android:textColor="@color/black"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/return_to_premium_with_special_discount"
                        android:fontFamily="@font/pro_display_medium"/>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_15sdp">
                        <RelativeLayout
                            android:id="@+id/btnSub"
                            android:background="@drawable/bg_button_sub_expired"
                            android:paddingLeft="@dimen/_16sdp"
                            android:paddingRight="@dimen/_16sdp"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_56sdp"
                            android:layout_marginTop="@dimen/_12sdp"
                            android:paddingHorizontal="@dimen/_16sdp"
                            android:outlineSpotShadowColor="@color/color_main">
                            <LinearLayout
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true">
                                <TextView
                                    android:textSize="@dimen/_18sdp"
                                    android:textColor="@color/white"
                                    android:id="@+id/tvTitleSub"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/weekly"
                                    android:fontFamily="@font/pro_display_bold"/>
                                <TextView
                                    android:textSize="@dimen/_11sdp"
                                    android:textStyle="italic"
                                    android:textColor="@color/white"
                                    android:id="@+id/tvPriceHighSub"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="10$"
                                    android:fontFamily="@font/pro_display_regular"
                                    android:layout_marginStart="@dimen/_5sdp"/>
                            </LinearLayout>
                            <TextView
                                android:textSize="@dimen/_18sdp"
                                android:textColor="@color/white"
                                android:id="@+id/tvPriceSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="10$"
                                android:layout_centerVertical="true"
                                android:fontFamily="@font/pro_display_bold"
                                android:layout_alignParentEnd="true"/>
                        </RelativeLayout>
                        <TextView
                            android:textSize="@dimen/_12sdp"
                            android:textColor="@color/white"
                            android:background="@drawable/bg_sale_50"
                            android:paddingLeft="@dimen/_16sdp"
                            android:paddingTop="@dimen/_4sdp"
                            android:paddingRight="@dimen/_16sdp"
                            android:paddingBottom="@dimen/_4sdp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="50% off"
                            android:layout_centerHorizontal="true"
                            android:fontFamily="@font/pro_display_bold"
                            android:paddingHorizontal="@dimen/_16sdp"
                            android:paddingVertical="@dimen/_4sdp"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/btnLifetime"
                        android:background="@drawable/bg_button_lifetime_expired"
                        android:paddingLeft="@dimen/_16sdp"
                        android:paddingRight="@dimen/_16sdp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_56sdp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:elevation="@dimen/_3sdp"
                        android:paddingHorizontal="@dimen/_16sdp"
                        android:outlineSpotShadowColor="@color/color_main">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true">
                            <TextView
                                android:textSize="@dimen/_18sdp"
                                android:textColor="@color/white"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/life_time"
                                android:fontFamily="@font/pro_display_bold"/>
                            <TextView
                                android:textSize="@dimen/_11sdp"
                                android:textStyle="italic"
                                android:textColor="@color/white"
                                android:id="@+id/tvPriceHighLifetime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="10$"
                                android:fontFamily="@font/pro_display_regular"
                                android:layout_marginStart="@dimen/_5sdp"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="@dimen/_18sdp"
                            android:textColor="@color/white"
                            android:id="@+id/tvPriceLifetime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10$"
                            android:layout_centerVertical="true"
                            android:fontFamily="@font/pro_display_bold"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/linearLayout19"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_12sdp"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:layout_marginRight="@dimen/_12sdp"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        app:layout_constraintTop_toBottomOf="@+id/linearLayout20">
                        <TextView
                            android:textSize="@dimen/_13sdp"
                            android:textColor="@color/color_text_new"
                            android:layout_gravity="center_horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/subscription_terms"
                            android:fontFamily="@font/pro_display_bold"/>
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_22sdp"
                            android:layout_marginTop="@dimen/_10sdp">
                            <TextView
                                android:textSize="@dimen/_12sdp"
                                android:textColor="@color/text_default"
                                android:gravity="center"
                                android:layout_gravity="center_horizontal"
                                android:id="@+id/tvTerms"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:text="@string/terms_amp_conditions"
                                android:layout_weight="1"
                                android:fontFamily="@font/pro_display_medium"
                                android:textAlignment="center"/>
                            <View
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold"
                                android:background="@color/text_default"
                                android:layout_width="1dp"
                                android:layout_height="@dimen/_22sdp"
                                android:text="|"/>
                            <TextView
                                android:textSize="@dimen/_12sdp"
                                android:textColor="@color/text_default"
                                android:gravity="center"
                                android:id="@+id/tvPolicy"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:text="@string/privacy_policy"
                                android:layout_weight="1"
                                android:fontFamily="@font/pro_display_medium"
                                android:textAlignment="center"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="@dimen/_11sdp"
                            android:textColor="@color/color_default"
                            android:id="@+id/tvMessage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:layout_marginBottom="@dimen/_15sdp"
                            android:text="@string/privacy_policy_des"
                            android:fontFamily="@font/pro_display_medium"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
