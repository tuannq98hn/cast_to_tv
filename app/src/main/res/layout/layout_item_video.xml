<?xml version="1.0" encoding="utf-8"?>
<!-- Video Hub video card (T6): #1b2029b2 card r32, 4:3 thumbnail with bottom scrim and duration pill, title below. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/_4sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/dc_bg_media_card"
        android:padding="@dimen/_6sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.cardview.widget.CardView
            android:id="@+id/card_thumb"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardBackgroundColor="@color/dc_bg_alt"
            app:cardCornerRadius="@dimen/_18sdp"
            app:cardElevation="0dp"
            app:layout_constraintDimensionRatio="4:3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/img_video_offline"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
            <View
                android:background="@drawable/dc_media_scrim_bottom"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="bottom|start"
                android:orientation="horizontal"
                android:background="@drawable/dc_bg_media_badge"
                android:paddingHorizontal="@dimen/_5sdp"
                android:paddingVertical="@dimen/_2sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_6sdp">
                <ImageView
                    android:layout_width="@dimen/_9sdp"
                    android:layout_height="@dimen/_9sdp"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/dc_primary"/>
                <TextView
                    android:id="@+id/tv_time"
                    style="@style/DC.Text"
                    android:textSize="@dimen/_9ssp"
                    android:textColor="@color/dc_text_body"
                    android:letterSpacing="0.08"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:text="0:00"
                    android:fontFamily="@font/pro_display_bold"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <TextView
            android:id="@+id/tv_name"
            style="@style/DC.Text"
            android:textSize="@dimen/_13ssp"
            android:textColor="@color/dc_text_primary"
            android:letterSpacing="0"
            android:ellipsize="end"
            android:singleLine="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_7sdp"
            android:layout_marginBottom="@dimen/_4sdp"
            android:paddingHorizontal="@dimen/_2sdp"
            android:text="@string/app_name"
            android:fontFamily="@font/pro_display_bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_thumb"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
