<?xml version="1.0" encoding="utf-8"?>
<!-- Photo Cast (Stitch "Photo Cast (Dark Cinema)"): media header, album chips with count, 2-column photo grid.
     Left out (no feature behind them): date sections, Select All / grid toggle, selection + Slideshow bar, bottom nav, 4K/HDR badges. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/dc_bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/header"
        layout="@layout/layout_media_header"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvListAlbum"
            android:paddingLeft="@dimen/_12sdp"
            android:paddingRight="@dimen/_12sdp"
            android:visibility="visible"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="@dimen/_12sdp"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/line"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintTop_toBottomOf="@+id/rcvListAlbum"/>
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:indeterminateTint="@color/dc_primary"
            app:layout_constraintTop_toBottomOf="@+id/line"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/vpgMedia"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/_12sdp"
            app:layout_constraintBottom_toTopOf="@+id/main_ads_native"
            app:layout_constraintTop_toBottomOf="@+id/progressBar"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_no_photo"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/main_ads_native"
            app:layout_constraintTop_toBottomOf="@+id/line"
            app:layout_constraintVertical_bias="0.3">
            <ImageView
                android:id="@+id/img_no_photo"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/img_no_photo"
                app:layout_constraintDimensionRatio="2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.7"/>
            <TextView
                android:textSize="@dimen/_14ssp"
                android:textColor="@color/dc_text_muted"
                android:layout_marginTop="@dimen/_8sdp"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/text_no_photo"
                android:fontFamily="@font/pro_display_semibold"
                app:layout_constraintEnd_toEndOf="@+id/img_no_photo"
                app:layout_constraintStart_toStartOf="@+id/img_no_photo"
                app:layout_constraintTop_toBottomOf="@+id/img_no_photo"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout android:visibility="gone"
            android:id="@+id/main_ads_native"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
