<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_mirror_web_0"
    android:background="@color/dc_bg"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_itemHeader"
        android:padding="@dimen/_5sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/imv_back"
            android:background="@drawable/dc_bg_key"
            app:tint="@color/dc_text_primary"
            android:padding="@dimen/_9sdp"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:src="@drawable/ic_back_arrow"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/_17sdp"
            android:textColor="@color/dc_text_primary"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_5sdp"
            android:layout_marginRight="@dimen/_5sdp"
            android:text="@string/mirror_web_cast"
            android:lines="1"
            android:layout_centerInParent="true"
            android:fontFamily="@font/pro_display_bold"
            android:layout_toEndOf="@+id/imv_back"
            android:layout_marginHorizontal="@dimen/_5sdp"/>
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/_12sdp"
        app:layout_constraintBottom_toTopOf="@+id/btn_start_screen_mirroring"
        app:layout_constraintTop_toBottomOf="@+id/rl_itemHeader">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/img_anim_loading"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginLeft="@dimen/_56sdp"
                    android:layout_marginTop="@dimen/_28sdp"
                    android:layout_marginRight="@dimen/_56sdp"
                    android:src="@drawable/imv_sm_web"
                    android:layout_marginHorizontal="@dimen/_56sdp"
                    app:layout_constraintDimensionRatio="1:0.7"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/dc_bg_glass_card"
                android:paddingTop="@dimen/_16sdp"
                android:paddingBottom="@dimen/_16sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginRight="@dimen/_16sdp"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:paddingVertical="@dimen/_16sdp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@+id/linearLayout9"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_12sdp"
                    android:layout_marginRight="@dimen/_12sdp"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    app:layout_constraintTop_toBottomOf="@+id/include6">
                    <TextView
                        android:textSize="@dimen/_14sdp"
                        android:textColor="@color/dc_text_body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/open_this_url_on_other_device"
                        android:fontFamily="@font/pro_display_regular"/>
                    <TextView
                        android:textSize="@dimen/_14sdp"
                        android:textColor="@color/dc_primary"
                        android:id="@+id/tvLink"
                        android:background="@drawable/dc_bg_button_secondary"
                        android:paddingLeft="@dimen/_12sdp"
                        android:paddingTop="@dimen/_10sdp"
                        android:paddingRight="@dimen/_12sdp"
                        android:paddingBottom="@dimen/_10sdp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:text="bcastmirror.com"
                        android:fontFamily="@font/pro_display_bold"
                        android:paddingHorizontal="@dimen/_12sdp"
                        android:paddingVertical="@dimen/_10sdp"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_36sdp"
                        android:layout_marginTop="@dimen/_8sdp">
                        <LinearLayout
                            android:gravity="center"
                            android:id="@+id/llCopy"
                            android:background="@drawable/dc_bg_button_secondary"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">
                            <ImageView
                                android:layout_width="@dimen/_24sdp"
                                android:layout_height="@dimen/_24sdp"
                                android:src="@drawable/ic_copy"
                                app:tint="@color/dc_primary"/>
                            <TextView
                                android:textSize="@dimen/_12sdp"
                                android:textColor="@color/dc_text_body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/copy"
                                android:fontFamily="@font/pro_display_medium"
                                android:layout_marginStart="8dp"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center"
                            android:id="@+id/llShare"
                            android:background="@drawable/dc_bg_button_secondary"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp">
                            <ImageView
                                android:layout_width="@dimen/_24sdp"
                                android:layout_height="@dimen/_24sdp"
                                android:src="@drawable/ic_share_network"
                                app:tint="@color/dc_primary"/>
                            <TextView
                                android:textSize="@dimen/_12sdp"
                                android:textColor="@color/dc_text_body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/share"
                                android:fontFamily="@font/pro_display_medium"
                                android:layout_marginStart="8dp"/>
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:textSize="@dimen/_14sdp"
                        android:textColor="@color/dc_text_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:text="@string/enter_the_code_shown_in_your_tv_or_scan_the_qr_code_to_start_mirroring"
                        android:fontFamily="@font/pro_display_regular"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/linearLayout10"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:layout_constraintTop_toBottomOf="@+id/include6">
                    <TextView
                        android:textSize="@dimen/_14sdp"
                        android:textColor="@color/dc_text_body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_12sdp"
                        android:layout_marginRight="@dimen/_12sdp"
                        android:text="@string/txt_cast_web_2"
                        android:fontFamily="@font/custom_font"
                        android:layout_marginHorizontal="@dimen/_12sdp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <Button
        android:textSize="@dimen/_16sdp"
        android:textColor="@color/dc_text_on_cta"
        android:gravity="center"
        android:id="@+id/btn_start_screen_mirroring"
        android:background="@drawable/dc_bg_cta_mirror"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_44sdp"
        android:layout_marginLeft="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_50sdp"
        android:layout_marginRight="@dimen/_16sdp"
        android:layout_marginBottom="@dimen/_24sdp"
        android:text="@string/code_verification"
        android:fontFamily="@font/pro_display_bold"
        android:layout_marginHorizontal="@dimen/_16sdp"
        app:layout_constraintBottom_toTopOf="@+id/layoutAds"
        app:layout_constraintVertical_bias="1"/>
    <RelativeLayout
        android:id="@+id/layoutAds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <FrameLayout android:visibility="gone"
            android:id="@+id/nativeAds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <FrameLayout
            android:id="@+id/bannerMirrorWeb"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/llConnected"
        android:background="@color/dc_scrim"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/dc_bg_dialog"
            android:paddingTop="@dimen/_40sdp"
            android:paddingBottom="@dimen/_40sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_40sdp"
            android:paddingVertical="@dimen/_40sdp"
            app:layout_constraintTop_toTopOf="parent">
            <com.airbnb.lottie.LottieAnimationView
                android:layout_gravity="center"
                android:id="@+id/lottieConnecting"
                android:layout_width="@dimen/_80sdp"
                android:layout_height="@dimen/_80sdp"
                android:layout_centerInParent="true"
                app:lottie_autoPlay="true"
                app:lottie_fileName="anim_loading.json"
                app:lottie_loop="true"/>
            <com.airbnb.lottie.LottieAnimationView
                android:layout_gravity="center"
                android:id="@+id/lottieConnected"
                android:visibility="gone"
                android:layout_width="@dimen/_80sdp"
                android:layout_height="@dimen/_80sdp"
                android:layout_centerInParent="true"
                app:lottie_fileName="anim_success_connect.json"/>
            <com.airbnb.lottie.LottieAnimationView
                android:layout_gravity="center"
                android:id="@+id/lottieConnectFail"
                android:visibility="gone"
                android:layout_width="@dimen/_80sdp"
                android:layout_height="@dimen/_80sdp"
                android:layout_centerInParent="true"
                app:lottie_fileName="anim_fail_connect.json"/>
            <TextView
                android:textSize="@dimen/_11sdp"
                android:textColor="@color/dc_text_primary"
                android:gravity="center"
                android:id="@+id/tvStatusConnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_20sdp"
                android:layout_marginTop="@dimen/_30sdp"
                android:layout_marginRight="@dimen/_20sdp"
                android:text="@string/connecting"
                android:fontFamily="@font/pro_display_bold"
                android:layout_marginHorizontal="@dimen/_20sdp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
