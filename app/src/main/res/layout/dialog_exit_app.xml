<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@color/transparent"
    android:paddingLeft="@dimen/_24sdp"
    android:paddingRight="@dimen/_24sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/_24sdp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:background="@drawable/bg_border"
        android:paddingLeft="@dimen/_12sdp"
        android:paddingTop="@dimen/_12sdp"
        android:paddingRight="@dimen/_12sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_12sdp"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout android:visibility="gone"
            android:id="@+id/main_ads_native"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_32sdp"/>
        <TextView
            android:textSize="@dimen/_15sdp"
            android:textColor="@color/color_txt"
            android:id="@+id/tvTitleExit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_8sdp"
            android:layout_marginRight="@dimen/_8sdp"
            android:text="@string/confirm_exit_app"
            android:fontFamily="@font/pro_display_bold"
            android:layout_marginHorizontal="@dimen/_8sdp"/>
        <TextView
            android:textSize="@dimen/_15sdp"
            android:textColor="@color/color_txt"
            android:id="@+id/tvDesExit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_8sdp"
            android:layout_marginTop="@dimen/p16"
            android:layout_marginRight="@dimen/_8sdp"
            android:layout_marginBottom="@dimen/p16"
            android:text="@string/are_you_sure_you_want_to_exit_app"
            android:fontFamily="@font/pro_display_regular"
            android:layout_marginHorizontal="@dimen/_8sdp"
            android:layout_marginVertical="@dimen/p16"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_5sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginRight="@dimen/_5sdp"
            android:layout_marginBottom="@dimen/_16sdp"
            android:layout_marginHorizontal="@dimen/_5sdp">
            <TextView
                android:textSize="@dimen/_14sdp"
                android:textColor="@color/color_default"
                android:gravity="center"
                android:id="@+id/tv_exit"
                android:background="@drawable/bg_button_cancel"
                android:paddingLeft="@dimen/_16sdp"
                android:paddingRight="@dimen/_16sdp"
                android:layout_width="0dp"
                android:layout_height="@dimen/_40sdp"
                android:text="@string/exit_app"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:fontFamily="@font/pro_display_bold"
                android:paddingHorizontal="@dimen/_16sdp"/>
            <TextView
                android:textSize="@dimen/_14sdp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_cancel"
                android:background="@drawable/bg_button"
                android:paddingLeft="@dimen/_16sdp"
                android:paddingRight="@dimen/_16sdp"
                android:layout_width="0dp"
                android:layout_height="@dimen/_40sdp"
                android:text="@string/cancel"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:fontFamily="@font/pro_display_bold"
                android:layout_marginStart="@dimen/_8sdp"
                android:paddingHorizontal="@dimen/_16sdp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
