<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@color/transparent"
    android:paddingHorizontal="@dimen/_24sdp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/dc_bg_dialog_opaque"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/_24sdp">
        <FrameLayout
            android:id="@+id/main_ads_native"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_16sdp"
            android:visibility="gone"/>
        <ImageView
            android:layout_width="@dimen/_56sdp"
            android:layout_height="@dimen/_56sdp"
            android:background="@drawable/dc_bg_icon_danger"
            android:importantForAccessibility="no"
            android:padding="@dimen/_18sdp"
            android:src="@drawable/ic_power_v2"
            app:tint="#fb7185"/>
        <TextView
            android:id="@+id/tvTitleExit"
            style="@style/DC.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp"
            android:gravity="center"
            android:text="@string/confirm_exit_app"/>
        <TextView
            android:id="@+id/tvDesExit"
            style="@style/DC.Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:fontFamily="@font/pro_display_regular"
            android:gravity="center"
            android:text="@string/are_you_sure_you_want_to_exit_app"
            android:textColor="@color/dc_key_icon"/>
        <TextView
            android:id="@+id/tv_exit"
            style="@style/DC.Text.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginTop="@dimen/_24sdp"
            android:background="@drawable/dc_bg_cta_danger"
            android:fontFamily="@font/pro_display_bold"
            android:text="@string/exit_app"
            android:textAllCaps="false"
            android:textSize="@dimen/_14ssp"
            android:textColor="@color/dc_text_primary"/>
        <TextView
            android:id="@+id/tv_cancel"
            style="@style/DC.Text.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/dc_bg_button_secondary"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textSize="@dimen/_14ssp"
            android:textColor="@color/dc_text_primary"/>
    </LinearLayout>
</FrameLayout>
