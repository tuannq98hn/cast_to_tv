<?xml version="1.0" encoding="utf-8"?>
<!-- Dark Cinema Connect Devices (Figma 1:1073): scan card, device list, connection guide (empty state), web cast pill CTA. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/dc_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/include9"
        layout="@layout/item_header"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_available_device"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/ll_web_cast"
        app:layout_constraintTop_toBottomOf="@+id/include9">
        <LinearLayout
            android:id="@+id/relativeLayout7"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:background="@drawable/dc_bg_glass_card"
            android:paddingTop="@dimen/_16sdp"
            android:paddingBottom="@dimen/_16sdp"
            android:paddingHorizontal="@dimen/_16sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginHorizontal="@dimen/_16sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/img_anim_loading"
                android:layout_width="@dimen/_164sdp"
                android:layout_height="@dimen/_20sdp"
                app:lottie_autoPlay="true"
                app:lottie_fileName="anim_dot_splash.json"
                app:lottie_loop="true"/>
            <ImageView
                android:id="@+id/imvNoWifi"
                android:visibility="gone"
                android:layout_width="@dimen/_120sdp"
                android:layout_height="@dimen/_120sdp"
                android:src="@drawable/img_no_wifi"/>
            <TextView
                android:id="@+id/txt_click"
                style="@style/DC.Text.Body"
                android:textColor="@color/dc_text_secondary"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:text="@string/text_click_name"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/linearLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/relativeLayout7">
            <TextView
                android:id="@+id/tvNameWifiConnect"
                style="@style/DC.Text.CardTitle"
                android:textColor="@color/dc_text_body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:text="@string/wifi_connected"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/rl_rv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/_12sdp"
            android:layout_marginBottom="@dimen/_12sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcv_list_device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </RelativeLayout>
        <ScrollView
            android:id="@+id/sv_not_device"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/_12sdp"
            android:layout_marginBottom="@dimen/_8sdp"
            android:layout_marginHorizontal="@dimen/_16sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout"
            app:layout_constraintVertical_bias="0">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_not_device"
                android:background="@drawable/dc_bg_media_card"
                android:padding="@dimen/_20sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:background="@drawable/dc_bg_count_badge"
                        android:padding="@dimen/_5sdp"
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:src="@drawable/ic_help"
                        app:tint="@color/dc_primary"/>
                    <TextView
                        style="@style/DC.Text.CardTitle"
                        android:textColor="@color/dc_text_body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:text="@string/user_guide"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_16sdp">
                    <TextView
                        style="@style/DC.Text"
                        android:textSize="@dimen/_12ssp"
                        android:fontFamily="@font/pro_display_bold"
                        android:textColor="@color/dc_violet_soft"
                        android:gravity="center"
                        android:background="@drawable/dc_bg_step_badge"
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:text="1"/>
                    <TextView
                        style="@style/DC.Text.Body"
                        android:textColor="@color/dc_text_secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_12sdp"
                        android:text="@string/make_sure_your_phone"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_14sdp">
                    <TextView
                        style="@style/DC.Text"
                        android:textSize="@dimen/_12ssp"
                        android:fontFamily="@font/pro_display_bold"
                        android:textColor="@color/dc_violet_soft"
                        android:gravity="center"
                        android:background="@drawable/dc_bg_step_badge"
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:text="2"/>
                    <TextView
                        style="@style/DC.Text.Body"
                        android:textColor="@color/dc_text_secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_12sdp"
                        android:text="@string/enable_the_wireless"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_14sdp">
                    <TextView
                        style="@style/DC.Text"
                        android:textSize="@dimen/_12ssp"
                        android:fontFamily="@font/pro_display_bold"
                        android:textColor="@color/dc_text_on_primary"
                        android:gravity="center"
                        android:background="@drawable/dc_bg_step_badge"
                        android:backgroundTint="@color/dc_primary"
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:text="3"/>
                    <TextView
                        style="@style/DC.Text.Body"
                        android:textColor="@color/dc_text_secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_12sdp"
                        android:text="@string/connection_successful"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_web_cast"
        android:background="@drawable/dc_bg_cta_pill"
        android:paddingHorizontal="@dimen/_20sdp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_46sdp"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:layout_marginBottom="@dimen/_20sdp"
        app:layout_constraintBottom_toTopOf="@+id/nativeAds">
        <ImageView
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:layout_marginEnd="@dimen/_7sdp"
            android:src="@drawable/dc_ic_language"
            android:importantForAccessibility="no"
            app:tint="#e0fdff"/>
        <TextView
            style="@style/DC.Text.Button"
            android:textColor="#e0fdff"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cast_web_browser"/>
    </LinearLayout>
    <FrameLayout android:visibility="gone"
        android:id="@+id/nativeAds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/llConnected"
        android:background="@color/dc_scrim"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/dc_bg_dialog"
            android:padding="@dimen/_32sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_40sdp">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieConnecting"
                android:layout_width="@dimen/_80sdp"
                android:layout_height="@dimen/_80sdp"
                app:lottie_autoPlay="true"
                app:lottie_fileName="anim_loading.json"
                app:lottie_loop="true"/>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieConnected"
                android:visibility="gone"
                android:layout_width="@dimen/_80sdp"
                android:layout_height="@dimen/_80sdp"
                app:lottie_fileName="anim_success_connect.json"/>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieConnectFail"
                android:visibility="gone"
                android:layout_width="@dimen/_80sdp"
                android:layout_height="@dimen/_80sdp"
                app:lottie_fileName="anim_fail_connect.json"/>
            <TextView
                android:id="@+id/txt_status_connect"
                style="@style/DC.Text.CardTitle"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_24sdp"
                android:text="@string/text_connecting"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
