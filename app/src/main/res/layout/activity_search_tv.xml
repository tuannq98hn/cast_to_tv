<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/include9"
        layout="@layout/item_header"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_available_device"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/ll_web_cast"
        app:layout_constraintTop_toBottomOf="@+id/include9">
        <RelativeLayout
            android:id="@+id/relativeLayout7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_10sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/_16sdp"
                android:textColor="@color/color_text_new"
                android:gravity="center"
                android:id="@+id/txt_click"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/text_click_name"
                android:fontFamily="@font/pro_display_bold"/>
            <com.airbnb.lottie.LottieAnimationView
                android:layout_gravity="center"
                android:id="@+id/img_anim_loading"
                android:layout_width="@dimen/_164sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_below="@+id/txt_click"
                android:layout_centerInParent="true"
                app:lottie_autoPlay="true"
                app:lottie_fileName="anim_dot_splash.json"
                app:lottie_loop="true"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/imvNoWifi"
                android:visibility="gone"
                android:layout_width="@dimen/_144sdp"
                android:layout_height="@dimen/_144sdp"
                android:src="@drawable/img_no_wifi"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/linearLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/relativeLayout7">
            <TextView
                android:textSize="@dimen/_14sdp"
                android:textColor="@color/color_text_new"
                android:id="@+id/tvNameWifiConnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:text="@string/wifi_connected"
                android:fontFamily="@font/pro_display_bold"
                android:layout_marginStart="@dimen/_8sdp"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/rl_rv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_16sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcv_list_device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </RelativeLayout>
        <ScrollView
            android:id="@+id/sv_not_device"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_16sdp"
            android:layout_marginRight="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_8sdp"
            android:layout_marginHorizontal="@dimen/_16sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout"
            app:layout_constraintVertical_bias="0">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_not_device"
                android:background="@drawable/bg_item_language"
                android:paddingTop="@dimen/_16sdp"
                android:paddingBottom="@dimen/_16sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/_16sdp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="@dimen/_16sdp"
                    android:paddingRight="@dimen/_16sdp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/_16sdp">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/bg_btn_refresh"
                        android:layout_width="@dimen/_26sdp"
                        android:layout_height="@dimen/_26sdp">
                        <TextView
                            android:textSize="@dimen/_14sdp"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1"
                            android:fontFamily="@font/pro_display_medium"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="@dimen/_14sdp"
                        android:textColor="@color/color_des"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/make_sure_your_phone"
                        android:fontFamily="@font/custom_font"
                        android:layout_marginStart="@dimen/_10sdp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="@dimen/_16sdp"
                    android:paddingRight="@dimen/_16sdp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:paddingHorizontal="@dimen/_16sdp">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/bg_btn_refresh"
                        android:layout_width="@dimen/_26sdp"
                        android:layout_height="@dimen/_26sdp">
                        <TextView
                            android:textSize="@dimen/_14sdp"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2"
                            android:fontFamily="@font/pro_display_medium"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="@dimen/_14sdp"
                        android:textColor="@color/color_des"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/enable_the_wireless"
                        android:fontFamily="@font/custom_font"
                        android:layout_marginStart="@dimen/_10sdp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="@dimen/_16sdp"
                    android:paddingRight="@dimen/_16sdp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:paddingHorizontal="@dimen/_16sdp">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/bg_btn_refresh"
                        android:layout_width="@dimen/_26sdp"
                        android:layout_height="@dimen/_26sdp">
                        <TextView
                            android:textSize="@dimen/_14sdp"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3"
                            android:fontFamily="@font/pro_display_medium"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="@dimen/_14sdp"
                        android:textColor="@color/color_des"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/connection_successful"
                        android:fontFamily="@font/pro_display_regular"
                        android:layout_marginStart="@dimen/_10sdp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_web_cast"
        android:background="@drawable/bg_btn_refresh"
        android:padding="@dimen/_10sdp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_50sdp"
        android:layout_marginLeft="@dimen/p16"
        android:layout_marginRight="@dimen/p16"
        android:layout_marginBottom="@dimen/_24sdp"
        android:layout_marginHorizontal="@dimen/p16"
        app:layout_constraintBottom_toTopOf="@+id/nativeAds">
        <TextView
            android:textSize="@dimen/_16sdp"
            android:textColor="@color/white"
            android:gravity="center"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginRight="@dimen/_10sdp"
            android:text="@string/cast_web_browser"
            android:fontFamily="@font/pro_display_bold"
            android:layout_marginHorizontal="@dimen/_10sdp"/>
    </LinearLayout>
    <FrameLayout android:visibility="gone"
        android:id="@+id/nativeAds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/llConnected"
        android:background="#99000000"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_border"
            android:padding="@dimen/_40sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_40sdp"
            app:layout_constraintTop_toTopOf="parent">
            <com.airbnb.lottie.LottieAnimationView
                android:layout_gravity="center"
                android:id="@+id/lottieConnecting"
                android:layout_width="@dimen/_80sdp"
                android:layout_height="@dimen/_80sdp"
                android:layout_centerInParent="true"
                app:lottie_autoPlay="true"
                app:lottie_fileName="anim_loading.json"
                app:lottie_loop="true"/>
            <com.airbnb.lottie.LottieAnimationView
                android:layout_gravity="center"
                android:id="@+id/lottieConnected"
                android:visibility="gone"
                android:layout_width="@dimen/_80sdp"
                android:layout_height="@dimen/_80sdp"
                android:layout_centerInParent="true"
                app:lottie_fileName="anim_success_connect.json"/>
            <com.airbnb.lottie.LottieAnimationView
                android:layout_gravity="center"
                android:id="@+id/lottieConnectFail"
                android:visibility="gone"
                android:layout_width="@dimen/_80sdp"
                android:layout_height="@dimen/_80sdp"
                android:layout_centerInParent="true"
                app:lottie_fileName="anim_fail_connect.json"/>
            <TextView
                android:textSize="@dimen/_14sdp"
                android:textColor="@color/black"
                android:id="@+id/txt_status_connect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_30sdp"
                android:text="@string/text_connecting"
                android:fontFamily="@font/pro_display_bold"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
