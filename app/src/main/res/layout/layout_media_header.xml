<?xml version="1.0" encoding="utf-8"?>
<!-- Media screens header (Stitch Photo Cast / Video Hub / Video Player): round back key, title with a connection line
     under it (dot + TV name, or "Tap to connect"), round cast key. Bound by BaseActivity.bindMediaHeader(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/_14sdp"
    android:paddingVertical="@dimen/_6sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/imv_back"
        android:background="@drawable/dc_bg_round_key"
        android:padding="@dimen/_9sdp"
        android:layout_width="@dimen/_34sdp"
        android:layout_height="@dimen/_34sdp"
        android:src="@drawable/dc_ic_chevron_left"
        android:contentDescription="@string/remote_key_back"
        app:tint="@color/dc_key_icon"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/_10sdp">
        <TextView
            style="@style/DC.Text"
            android:id="@+id/tv_title"
            android:fontFamily="@font/pro_display_bold"
            android:textSize="@dimen/_17ssp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:id="@+id/ll_status"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp">
            <View
                android:id="@+id/view_status_dot"
                android:background="@drawable/dc_bg_pulse_dot"
                android:layout_width="@dimen/_5sdp"
                android:layout_height="@dimen/_5sdp"
                android:layout_marginEnd="@dimen/_5sdp"/>
            <TextView
                style="@style/DC.Text"
                android:id="@+id/tv_status"
                android:fontFamily="@font/pro_display_medium"
                android:textColor="@color/dc_text_muted"
                android:textSize="@dimen/_10ssp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_to_connect"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/cast_connect"
        android:background="@drawable/dc_bg_round_key"
        android:padding="@dimen/_8sdp"
        android:layout_width="@dimen/_34sdp"
        android:layout_height="@dimen/_34sdp"
        android:src="@drawable/dc_ic_cast"
        app:tint="@color/dc_primary_soft"/>
</LinearLayout>
