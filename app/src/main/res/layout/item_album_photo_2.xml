<?xml version="1.0" encoding="utf-8"?>
<!-- Photo Cast album chip: glass pill, or indigo-to-cyan pill with a photo-count badge when selected. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingVertical="@dimen/_6sdp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/_3sdp">
    <LinearLayout
        android:id="@+id/llBg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/dc_bg_chip"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingVertical="@dimen/_6sdp"
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tvNameAlbum"
            android:textSize="@dimen/_11ssp"
            android:textColor="@color/dc_text_secondary"
            android:letterSpacing="0.02"
            android:includeFontPadding="false"
            android:fontFamily="@font/pro_display_semibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Album"/>
        <TextView
            android:id="@+id/tvCount"
            android:background="@drawable/dc_bg_pill"
            android:backgroundTint="#4d000000"
            android:textSize="@dimen/_8ssp"
            android:textColor="@color/dc_text_primary"
            android:includeFontPadding="false"
            android:fontFamily="@font/pro_display_bold"
            android:paddingHorizontal="@dimen/_5sdp"
            android:paddingVertical="@dimen/_2sdp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_6sdp"/>
    </LinearLayout>
</LinearLayout>
