<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/bottom_sheet_code_0"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_sheet_16_main"
        android:paddingLeft="16dp"
        android:paddingTop="24dp"
        android:paddingRight="16dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="24dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="13dp"
            android:textColor="@color/color_text_new"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_code_dialog"
            android:layout_alignParentBottom="true"
            android:fontFamily="@font/roboto_medium"/>
        <com.casttotv.screen.mirroring.utils.pinview.Pinview
            android:id="@+id/pinView"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:layout_marginVertical="24dp"
            app:forceKeyboard="false"
            app:inputType="number"
            app:pinHeight="48dp"
            app:pinLength="6"
            app:pinWidth="40dp"
            app:splitWidth="12dp"
            app:textSize="12dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tvScanQr"
            android:background="@drawable/bg_press_screen_mirror"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/scan_qr"
            android:textAllCaps="false"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
