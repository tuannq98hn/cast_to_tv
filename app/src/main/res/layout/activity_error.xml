<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="@dimen/customactivityoncrash_activity_horizontal_margin"
            android:paddingTop="@dimen/customactivityoncrash_activity_vertical_margin"
            android:paddingRight="@dimen/customactivityoncrash_activity_horizontal_margin"
            android:paddingBottom="@dimen/customactivityoncrash_activity_vertical_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/error_activity_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_error_application"
                android:contentDescription="@null"/>
            <com.casttotv.screen.mirroring.ui.view.TextViewCGT
                android:textSize="@dimen/_15sdp"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/customactivityoncrash_activity_vertical_margin"
                android:text="@string/error_activity_error_occurred_explanation"/>
            <com.casttotv.screen.mirroring.ui.view.ButtonCGT
                android:textSize="@dimen/_13sdp"
                android:id="@+id/btn_restart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/customactivityoncrash_activity_vertical_margin"
                android:text="@string/error_activity_close_app"/>
            <com.casttotv.screen.mirroring.ui.view.ButtonCGT
                android:textSize="@dimen/_13sdp"
                android:textColor="?attr/colorPrimary"
                android:id="@+id/error_activity_more_info_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/error_activity_error_details"
                style="?attr/borderlessButtonStyle"/>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
