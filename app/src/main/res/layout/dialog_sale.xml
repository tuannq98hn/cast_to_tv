<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ct1"
        android:background="@drawable/dc_bg_dialog"
        android:paddingLeft="@dimen/_16sdp"
        android:paddingTop="@dimen/_24sdp"
        android:paddingRight="@dimen/_16sdp"
        android:paddingBottom="@dimen/_24sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_24sdp"
        android:layout_marginRight="@dimen/_24sdp"
        android:layout_marginHorizontal="@dimen/_24sdp"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingVertical="@dimen/_24sdp"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/_16sdp"
            android:textColor="@color/dc_text_muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Not really to buy?"
            android:fontFamily="@font/pro_display_medium"/>
        <TextView
            android:textSize="@dimen/_24sdp"
            android:textColor="@color/dc_text_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:text="Cast TV Discount"
            android:gravity="center"
            android:fontFamily="@font/pro_display_bold"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_24sdp"
            android:weightSum="3">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:src="@drawable/ic_screen"/>
                <TextView
                    android:textSize="@dimen/_13sdp"
                    android:textColor="@color/dc_text_primary"
                    android:gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:text="Ultimate Mirror"
                    android:fontFamily="@font/pro_display_regular"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/_16sdp">
                <ImageView
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:src="@drawable/ic_unlock"/>
                <TextView
                    android:textSize="@dimen/_13sdp"
                    android:textColor="@color/dc_text_primary"
                    android:gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:text="Unlock All Features"
                    android:fontFamily="@font/pro_display_regular"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/_16sdp">
                <ImageView
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:src="@drawable/ic_remove_ads"/>
                <TextView
                    android:textSize="@dimen/_13sdp"
                    android:textColor="@color/dc_text_primary"
                    android:gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:text="Remove All Ads"
                    android:fontFamily="@font/pro_display_regular"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="@dimen/_6sdp"
            android:paddingBottom="@dimen/_6sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:paddingVertical="@dimen/_6sdp">
            <TextView
                android:textSize="@dimen/_16sdp"
                android:textColor="@color/dc_primary_soft"
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pro_display_bold"/>
            <TextView
                android:textSize="@dimen/_24sdp"
                android:textColor="@color/dc_text_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/year"
                android:fontFamily="@font/pro_display_semibold"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/_14sdp"
            android:textColor="@color/dc_text_primary"
            android:id="@+id/tvDesPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/regular_price_for_year_s"
            android:fontFamily="@font/pro_display_medium"/>
        <TextView
            style="@style/DC.Text.Button"
            android:textColor="@color/dc_text_primary"
            android:textAllCaps="true"
            android:id="@+id/btnContinue"
            android:background="@drawable/dc_bg_cta_gradient"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_48sdp"
            android:layout_marginTop="@dimen/_16sdp"
            android:text="@string/continue_s"/>
    </LinearLayout>
    <ImageButton
        android:id="@+id/img_close"
        android:background="@drawable/ic_close"
        android:paddingLeft="@dimen/_3sdp"
        android:paddingRight="@dimen/_3sdp"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="@dimen/_32sdp"
        android:layout_marginTop="@dimen/_24sdp"
        android:layout_below="@+id/ct1"
        android:layout_centerHorizontal="true"
        android:backgroundTint="@color/white"
        android:paddingHorizontal="@dimen/_3sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ct1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
