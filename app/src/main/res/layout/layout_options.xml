<?xml version="1.0" encoding="utf-8"?>
<!-- Dark Cinema plan cards (Stitch "Extended Subscription Options" rows, no radio/selection: these cards have no handler). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/testing_1_button_month"
        android:background="@drawable/dc_bg_glass_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_14sdp"
        android:paddingVertical="@dimen/_12sdp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="@dimen/_13ssp"
                android:textColor="@color/dc_text_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/monthly"
                android:fontFamily="@font/pro_display_bold"/>
            <TextView
                android:textSize="@dimen/_10ssp"
                android:textColor="@color/dc_text_muted"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pay_once_a_month"
                android:fontFamily="@font/pro_display_regular"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/_14ssp"
            android:textColor="@color/dc_primary_soft"
            android:id="@+id/testing_1_button_month_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:fontFamily="@font/pro_display_bold"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/testing_1_button_one_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:background="@drawable/dc_bg_glass_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:paddingHorizontal="@dimen/_14sdp"
            android:paddingVertical="@dimen/_12sdp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true">
                <TextView
                    android:textSize="@dimen/_13ssp"
                    android:textColor="@color/dc_text_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/life_time"
                    android:fontFamily="@font/pro_display_bold"/>
                <TextView
                    android:textSize="@dimen/_10ssp"
                    android:textColor="@color/dc_text_muted"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/limited_offer"
                    android:fontFamily="@font/pro_display_regular"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/_14ssp"
                android:textColor="@color/dc_primary_soft"
                android:id="@+id/testing_1_button_one_time_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:fontFamily="@font/pro_display_bold"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>
