<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/dc_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/header"
        layout="@layout/item_header"/>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/_24sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_premium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_14sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_14sdp">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:id="@+id/ll_premium"
                    android:background="@drawable/dc_bg_vip_card"
                    android:padding="@dimen/_16sdp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/llNotPay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            style="@style/DC.Text.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/try_3day"/>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_14sdp">
                            <ImageView
                                android:background="@drawable/dc_bg_check_gold"
                                android:padding="@dimen/_3sdp"
                                android:layout_width="@dimen/_16sdp"
                                android:layout_height="@dimen/_16sdp"
                                android:src="@drawable/dc_ic_check"
                                app:tint="@color/dc_gold"/>
                            <TextView
                                style="@style/DC.Text.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_10sdp"
                                android:text="@string/txt1_setting"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_8sdp">
                            <ImageView
                                android:background="@drawable/dc_bg_check_gold"
                                android:padding="@dimen/_3sdp"
                                android:layout_width="@dimen/_16sdp"
                                android:layout_height="@dimen/_16sdp"
                                android:src="@drawable/dc_ic_check"
                                app:tint="@color/dc_gold"/>
                            <TextView
                                style="@style/DC.Text.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_10sdp"
                                android:text="@string/txt2_setting"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_8sdp">
                            <ImageView
                                android:background="@drawable/dc_bg_check_gold"
                                android:padding="@dimen/_3sdp"
                                android:layout_width="@dimen/_16sdp"
                                android:layout_height="@dimen/_16sdp"
                                android:src="@drawable/dc_ic_check"
                                app:tint="@color/dc_gold"/>
                            <TextView
                                style="@style/DC.Text.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_10sdp"
                                android:text="@string/txt3_setting"/>
                        </LinearLayout>
                    </LinearLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_16sdp">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:id="@+id/tv_premium"
                            android:background="@drawable/dc_bg_cta_gold"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_44sdp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <ImageView
                                android:clickable="false"
                                android:layout_width="@dimen/_18sdp"
                                android:layout_height="@dimen/_18sdp"
                                android:src="@drawable/ic_tag_vip"
                                app:tint="@color/dc_crown_icon"/>
                            <TextView
                                style="@style/DC.Text.Button"
                                android:textSize="@dimen/_14ssp"
                                android:textColor="@color/dc_crown_icon"
                                android:fontFamily="@font/pro_display_bold"
                                android:clickable="false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/start_trial"
                                android:textAllCaps="true"
                                android:layout_marginStart="@dimen/_8sdp"/>
                        </LinearLayout>
                        <View
                            android:id="@+id/shine"
                            android:background="@drawable/img_view_load"
                            android:layout_width="@dimen/_56sdp"
                            android:layout_height="0dp"
                            android:layout_marginStart="@dimen/_minus30sdp"
                            android:alpha="0.5"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                style="@style/DC.Settings.Section"
                android:text="@string/general"/>
            <LinearLayout
                style="@style/DC.Settings.Group"
                android:id="@+id/linearLayout7">
                <LinearLayout
                    style="@style/DC.Settings.Row"
                    android:id="@+id/rl_language">
                    <ImageView
                        style="@style/DC.Settings.Icon"
                        android:backgroundTint="@color/dc_blue"
                        android:src="@drawable/ic_language"/>
                    <TextView
                        style="@style/DC.Settings.Title"
                        android:text="@string/language"/>
                    <TextView
                        style="@style/DC.Text.Caption"
                        android:textColor="@color/dc_primary"
                        android:fontFamily="@font/pro_display_semibold"
                        android:id="@+id/txt_language"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/_6sdp"/>
                    <ImageView
                        style="@style/DC.Settings.Chevron"
                        android:id="@+id/ib_right"/>
                </LinearLayout>
                <View style="@style/DC.Settings.Divider"/>
                <LinearLayout style="@style/DC.Settings.Row">
                    <ImageView
                        style="@style/DC.Settings.Icon"
                        android:backgroundTint="@color/dc_amber"
                        android:src="@drawable/ic_vibration"/>
                    <TextView
                        style="@style/DC.Settings.Title"
                        android:text="@string/txt_hapic"/>
                    <ToggleButton
                        android:id="@+id/tbVibrate"
                        android:background="@drawable/ic_vibrate"
                        android:layout_width="@dimen/_38sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:checked="true"
                        android:textOn=""
                        android:textOff=""/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/DC.Settings.Section"
                android:text="@string/tutorial"/>
            <LinearLayout style="@style/DC.Settings.Group">
                <LinearLayout
                    style="@style/DC.Settings.Row"
                    android:id="@+id/rl_hty3">
                    <ImageView
                        style="@style/DC.Settings.Icon"
                        android:backgroundTint="@color/dc_indigo_soft"
                        android:src="@drawable/ic_intro_connect"/>
                    <TextView
                        style="@style/DC.Settings.Title"
                        android:text="@string/intro_connects"/>
                    <ImageView style="@style/DC.Settings.Chevron"/>
                </LinearLayout>
                <View style="@style/DC.Settings.Divider"/>
                <LinearLayout
                    style="@style/DC.Settings.Row"
                    android:id="@+id/rl_hty2">
                    <ImageView
                        style="@style/DC.Settings.Icon"
                        android:backgroundTint="@color/dc_cyan"
                        android:src="@drawable/ic_header_connected"/>
                    <TextView
                        style="@style/DC.Settings.Title"
                        android:text="@string/intro_remote"/>
                    <ImageView style="@style/DC.Settings.Chevron"/>
                </LinearLayout>
                <View style="@style/DC.Settings.Divider"/>
                <LinearLayout
                    style="@style/DC.Settings.Row"
                    android:id="@+id/rl_hty1">
                    <ImageView
                        style="@style/DC.Settings.Icon"
                        android:backgroundTint="@color/dc_amber"
                        android:src="@drawable/ic_mirror_setting"/>
                    <TextView
                        style="@style/DC.Settings.Title"
                        android:text="@string/intro_connect"/>
                    <ImageView style="@style/DC.Settings.Chevron"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/DC.Settings.Section"
                android:text="@string/more"/>
            <LinearLayout style="@style/DC.Settings.Group">
                <LinearLayout
                    style="@style/DC.Settings.Row"
                    android:id="@+id/rl_feedback">
                    <ImageView
                        style="@style/DC.Settings.Icon"
                        android:backgroundTint="@color/dc_pink"
                        android:src="@drawable/ic_feedback"/>
                    <TextView
                        style="@style/DC.Settings.Title"
                        android:text="@string/feedback"/>
                    <ImageView style="@style/DC.Settings.Chevron"/>
                </LinearLayout>
                <View style="@style/DC.Settings.Divider"/>
                <LinearLayout
                    style="@style/DC.Settings.Row"
                    android:id="@+id/rl_share">
                    <ImageView
                        style="@style/DC.Settings.Icon"
                        android:backgroundTint="@color/dc_sky"
                        android:src="@drawable/ic_share"/>
                    <TextView
                        style="@style/DC.Settings.Title"
                        android:text="@string/share_this"/>
                    <ImageView style="@style/DC.Settings.Chevron"/>
                </LinearLayout>
                <View style="@style/DC.Settings.Divider"/>
                <LinearLayout
                    style="@style/DC.Settings.Row"
                    android:id="@+id/rl_rate">
                    <ImageView
                        style="@style/DC.Settings.Icon"
                        android:backgroundTint="@color/dc_amber"
                        android:src="@drawable/ic_rate"/>
                    <TextView
                        style="@style/DC.Settings.Title"
                        android:text="@string/rate"/>
                    <ImageView style="@style/DC.Settings.Chevron"/>
                </LinearLayout>
                <View style="@style/DC.Settings.Divider"/>
                <LinearLayout
                    style="@style/DC.Settings.Row"
                    android:id="@+id/rl_privacy">
                    <ImageView
                        style="@style/DC.Settings.Icon"
                        android:backgroundTint="@color/dc_text_subtle"
                        android:src="@drawable/ic_privacy"/>
                    <TextView
                        style="@style/DC.Settings.Title"
                        android:text="@string/privacy_policy"/>
                    <ImageView style="@style/DC.Settings.Chevron"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/DC.Text.Caption"
                android:textColor="@color/dc_text_muted"
                android:gravity="center"
                android:id="@+id/tv_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_24sdp"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
