<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/dc_bg"
    android:paddingLeft="@dimen/_12sdp"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="right"
        android:id="@+id/imv_close"
        android:padding="@dimen/_8sdp"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:layout_margin="@dimen/_8sdp"
        android:src="@drawable/ic_close_1"/>
    <TextView
        android:textSize="@dimen/_24sdp"
        android:textColor="@color/dc_text_primary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:text="@string/user_guide"
        android:fontFamily="@font/pro_display_medium"/>
    <TextView
        android:textSize="@dimen/_12sdp"
        android:textColor="@color/dc_text_body"
        android:paddingRight="@dimen/_24sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16sdp"
        android:text="@string/_1_your_android_device_needs_to_be_connected_to_the_same_wi_fi_network_as_your_fire_stick_tv"
        android:fontFamily="@font/pro_display_regular"/>
    <TextView
        android:textSize="@dimen/_12sdp"
        android:textColor="@color/dc_text_body"
        android:paddingRight="@dimen/_24sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:text="@string/_2_on_fire_stick_tv_home_screen_scroll_right_and_select_settings_screen"
        android:fontFamily="@font/pro_display_regular"/>
    <TextView
        android:textSize="@dimen/_12sdp"
        android:textColor="@color/dc_text_body"
        android:paddingRight="@dimen/_24sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:text="@string/_3_scroll_right_and_select_my_fire_tv"
        android:fontFamily="@font/pro_display_regular"/>
    <TextView
        android:textSize="@dimen/_12sdp"
        android:textColor="@color/dc_text_body"
        android:paddingRight="@dimen/_24sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:text="@string/_4_scroll_down_and_select_developer_options"
        android:fontFamily="@font/pro_display_regular"/>
    <TextView
        android:textSize="@dimen/_12sdp"
        android:textColor="@color/dc_text_body"
        android:paddingRight="@dimen/_24sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:text="@string/_5_turn_on_adb_debugging"
        android:fontFamily="@font/pro_display_regular"/>
</LinearLayout>
