<?xml version="1.0" encoding="utf-8"?>
<!-- Dark Cinema casting dialog: modal card (dc_bg_dialog) with the Cast Player "BUFFERING STREAM" look. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@drawable/dc_bg_dialog"
    android:padding="@dimen/_18sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_20sdp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            style="@style/DC.Text.CardTitle"
            android:textColor="@color/dc_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/buffering"/>
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="center"
            android:id="@+id/lav_loading_gift"
            android:layout_width="@dimen/_100sdp"
            android:layout_height="@dimen/_100sdp"
            app:lottie_autoPlay="true"
            app:lottie_fileName="loading_cast.json"
            app:lottie_loop="true"/>
    </LinearLayout>
    <TextView
        style="@style/DC.Text.Body"
        android:textColor="@color/dc_primary"
        android:id="@+id/tv_help"
        android:padding="@dimen/_5sdp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/_10sdp"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:text="@string/help"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
