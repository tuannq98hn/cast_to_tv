<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_250sdp"
    android:layout_marginLeft="@dimen/_40sdp"
    android:layout_marginRight="@dimen/_40sdp"
    android:layout_marginHorizontal="@dimen/_40sdp">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/dc_bg_dialog"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/_16sdp"
            android:layout_weight="1.5">
            <ImageView
                android:layout_width="@dimen/_180sdp"
                android:layout_height="@dimen/_120sdp"
                android:src="@drawable/ic_bg_disconnect_dialog"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/_14sdp"
            android:textColor="@color/dc_text_body"
            android:gravity="center"
            android:id="@+id/tv_title_disconnect"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_24sdp"
            android:layout_marginTop="@dimen/_16sdp"
            android:layout_marginRight="@dimen/_24sdp"
            android:text="@string/title_disconnect"
            android:fontFamily="@font/pro_display_regular"
            android:layout_marginHorizontal="@dimen/_24sdp"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_16sdp"
            android:layout_marginVertical="@dimen/_16sdp">
            <TextView
                android:textSize="@dimen/_14sdp"
                android:textColor="@color/dc_danger"
                android:gravity="center"
                android:id="@+id/tv_cancel"
                android:background="@drawable/dc_bg_button_secondary"
                android:paddingLeft="@dimen/_16sdp"
                android:paddingRight="@dimen/_16sdp"
                android:layout_width="@dimen/_112sdp"
                android:layout_height="@dimen/_40sdp"
                android:text="@string/disconnect"
                android:textAllCaps="false"
                android:fontFamily="@font/pro_display_bold"
                android:paddingHorizontal="@dimen/_16sdp"/>
            <TextView
                android:textSize="@dimen/_14sdp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_disconnect"
                android:background="@drawable/dc_bg_cta_gradient"
                android:paddingLeft="@dimen/_16sdp"
                android:paddingRight="@dimen/_16sdp"
                android:layout_width="@dimen/_112sdp"
                android:layout_height="@dimen/_40sdp"
                android:text="@string/continue_sub"
                android:textAllCaps="false"
                android:fontFamily="@font/pro_display_bold"
                android:layout_marginStart="@dimen/_8sdp"
                android:paddingHorizontal="@dimen/_16sdp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
