<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app2="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:padding="@dimen/_8sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.github.siyamed.shapeimageview.RoundedImageView
        android:id="@+id/iv_poster"
        android:background="@drawable/ic_video_default"
        android:visibility="visible"
        android:layout_width="@dimen/_64sdp"
        android:layout_height="@dimen/_64sdp"
        android:layout_centerInParent="true"
        app2:layout_constraintBottom_toBottomOf="parent"
        app2:layout_constraintStart_toStartOf="parent"
        app2:layout_constraintTop_toTopOf="parent"
        app2:siRadius="@dimen/_8sdp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/linearLayout15"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_16sdp"
        android:layout_marginRight="@dimen/_16sdp"
        android:layout_marginHorizontal="@dimen/_16sdp"
        app2:layout_constraintBottom_toTopOf="@+id/linearLayout2"
        app2:layout_constraintEnd_toEndOf="parent"
        app2:layout_constraintStart_toEndOf="@+id/iv_poster"
        app2:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textSize="@dimen/_14sdp"
            android:textColor="@color/color_text_new"
            android:id="@+id/tv_film_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Title"
            android:maxLines="2"
            android:fontFamily="@font/pro_display_bold"
            app2:layout_constraintEnd_toEndOf="parent"
            app2:layout_constraintLeft_toRightOf="@+id/cvImage"
            app2:layout_constraintStart_toEndOf="@+id/cvImage"
            app2:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/_11sdp"
            android:textColor="@color/color_default"
            android:layout_gravity="left"
            android:id="@+id/txtVidSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/SizeUnknown"
            android:layout_weight="1"
            app2:layout_constraintLeft_toRightOf="@+id/cvImage"
            app2:layout_constraintTop_toBottomOf="@+id/tv_film_name"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/linearLayout2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginRight="@dimen/_16sdp"
        android:layout_marginHorizontal="@dimen/_16sdp"
        app2:layout_constraintBottom_toBottomOf="parent"
        app2:layout_constraintEnd_toEndOf="parent"
        app2:layout_constraintHorizontal_bias="0.5"
        app2:layout_constraintStart_toEndOf="@+id/iv_poster"
        app2:layout_constraintTop_toBottomOf="@+id/linearLayout15">
        <TextView
            android:textSize="@dimen/_14sdp"
            android:textColor="@color/color_main"
            android:gravity="center"
            android:layout_gravity="right"
            android:id="@+id/btnPreview"
            android:background="@drawable/bg_button_old"
            android:layout_width="0dp"
            android:layout_height="@dimen/_28sdp"
            android:text="@string/Preview"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:fontFamily="@font/pro_display_bold"
            android:layout_marginEnd="@dimen/_12sdp"/>
        <TextView
            android:textSize="@dimen/_14sdp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="right"
            android:id="@+id/btnDownload"
            android:background="@drawable/bg_button"
            android:layout_width="0dp"
            android:layout_height="@dimen/_28sdp"
            android:layout_marginLeft="2dp"
            android:text="@string/cast"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:fontFamily="@font/pro_display_bold"
            android:drawableTint="@color/white"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
