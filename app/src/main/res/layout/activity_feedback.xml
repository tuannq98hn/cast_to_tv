<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/_16sdp"
        app:layout_constraintBottom_toTopOf="@+id/btn_submit"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_16sdp"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/img_back"
                    android:padding="@dimen/_4sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_back"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/_18sdp"
                    android:textColor="@color/color_text_new"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_16sdp"
                    android:layout_marginRight="@dimen/_16sdp"
                    android:text="@string/feedback_1"
                    android:layout_weight="1"
                    android:fontFamily="@font/pro_display_bold"
                    android:layout_marginHorizontal="@dimen/_16sdp"/>
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/anim_messenger"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    app:lottie_autoPlay="true"
                    app:lottie_fileName="anim_messenger.json"
                    app:lottie_loop="true"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_main"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_32sdp"
                android:src="@drawable/img_feedback"
                app:layout_constraintDimensionRatio="1.53"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ll_main"/>
            <TextView
                android:textSize="@dimen/_18sdp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/txt_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:text="@string/text_tell_us_problem"
                android:fontFamily="@font/pro_display_bold"
                app:layout_constraintTop_toBottomOf="@+id/img_main"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_selected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_16sdp"
                android:layout_marginRight="@dimen/_16sdp"
                android:layout_marginHorizontal="@dimen/_16sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txt_main">
                <TextView
                    android:textSize="@dimen/_14sdp"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:id="@+id/txt_cant_connect"
                    android:background="@drawable/bg_item_feedback"
                    android:paddingLeft="@dimen/_16sdp"
                    android:paddingTop="@dimen/_8sdp"
                    android:paddingRight="@dimen/_16sdp"
                    android:paddingBottom="@dimen/_8sdp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/text_error_1"
                    android:maxLines="1"
                    android:fontFamily="@font/pro_display_medium"
                    android:paddingHorizontal="@dimen/_16sdp"
                    android:paddingVertical="@dimen/_8sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.4"/>
                <TextView
                    android:textSize="@dimen/_14sdp"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:id="@+id/txt_not_working"
                    android:background="@drawable/bg_item_feedback"
                    android:paddingLeft="@dimen/_16sdp"
                    android:paddingTop="@dimen/_8sdp"
                    android:paddingRight="@dimen/_16sdp"
                    android:paddingBottom="@dimen/_8sdp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/text_error_2"
                    android:maxLines="1"
                    android:fontFamily="@font/pro_display_medium"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:paddingHorizontal="@dimen/_16sdp"
                    android:paddingVertical="@dimen/_8sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toEndOf="@+id/txt_cant_connect"
                    app:layout_constraintTop_toTopOf="@+id/txt_cant_connect"
                    app:layout_constraintWidth_percent="0.4"/>
                <TextView
                    android:textSize="@dimen/_14sdp"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:id="@+id/txt_crash"
                    android:background="@drawable/bg_item_feedback"
                    android:paddingLeft="@dimen/_16sdp"
                    android:paddingTop="@dimen/_8sdp"
                    android:paddingRight="@dimen/_16sdp"
                    android:paddingBottom="@dimen/_8sdp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:text="@string/text_error_3"
                    android:maxLines="1"
                    android:fontFamily="@font/pro_display_medium"
                    android:paddingHorizontal="@dimen/_16sdp"
                    android:paddingVertical="@dimen/_8sdp"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/txt_cant_connect"
                    app:layout_constraintWidth_percent="0.3"/>
                <TextView
                    android:textSize="@dimen/_14sdp"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:id="@+id/txt_suggestion"
                    android:background="@drawable/bg_item_feedback"
                    android:paddingLeft="@dimen/_16sdp"
                    android:paddingTop="@dimen/_8sdp"
                    android:paddingRight="@dimen/_16sdp"
                    android:paddingBottom="@dimen/_8sdp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/text_error_4"
                    android:maxLines="1"
                    android:fontFamily="@font/pro_display_medium"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:paddingHorizontal="@dimen/_16sdp"
                    android:paddingVertical="@dimen/_8sdp"
                    app:layout_constraintBottom_toBottomOf="@+id/txt_crash"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toEndOf="@+id/txt_crash"
                    app:layout_constraintTop_toTopOf="@+id/txt_crash"
                    app:layout_constraintWidth_percent="0.3"/>
                <TextView
                    android:textSize="@dimen/_14sdp"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:id="@+id/txt_other"
                    android:background="@drawable/bg_item_feedback"
                    android:paddingLeft="@dimen/_16sdp"
                    android:paddingTop="@dimen/_8sdp"
                    android:paddingRight="@dimen/_16sdp"
                    android:paddingBottom="@dimen/_8sdp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/text_error_3"
                    android:maxLines="1"
                    android:fontFamily="@font/pro_display_medium"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:paddingHorizontal="@dimen/_16sdp"
                    android:paddingVertical="@dimen/_8sdp"
                    app:layout_constraintBottom_toBottomOf="@+id/txt_suggestion"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toEndOf="@+id/txt_suggestion"
                    app:layout_constraintTop_toTopOf="@+id/txt_suggestion"
                    app:layout_constraintWidth_percent="0.3"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@+id/view"
                android:background="#f3f6ff"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_30sdp"
                android:layout_marginRight="@dimen/_16sdp"
                android:layout_marginHorizontal="@dimen/_16sdp"
                app:layout_constraintTop_toBottomOf="@+id/cl_selected"/>
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="@dimen/_14sdp"
                android:textColor="@color/black"
                android:textColorHint="@color/color_hint"
                android:gravity="top"
                android:id="@+id/edt_input"
                android:background="@color/transparent"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_300sdp"
                android:layout_marginLeft="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginRight="@dimen/_16sdp"
                android:hint="@string/text_feedback"
                android:fontFamily="@font/pro_display_regular"
                android:layout_marginHorizontal="@dimen/_16sdp"
                app:layout_constraintTop_toBottomOf="@+id/view"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <TextView
        android:textColor="@color/color_hint"
        android:gravity="center"
        android:id="@+id/btn_submit"
        android:background="@drawable/bg_button_feedback_disable"
        android:paddingLeft="@dimen/_16sdp"
        android:paddingTop="@dimen/_12sdp"
        android:paddingRight="@dimen/_16sdp"
        android:paddingBottom="@dimen/_12sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_16sdp"
        android:text="@string/submit"
        android:textAllCaps="true"
        android:fontFamily="@font/pro_display_bold"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingVertical="@dimen/_12sdp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
