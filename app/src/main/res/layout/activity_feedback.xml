<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/dc_bg_ambient_top"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/_16sdp"
        app:layout_constraintBottom_toTopOf="@+id/btn_submit"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_16sdp"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/img_back"
                    android:background="@drawable/dc_bg_key"
                    android:padding="@dimen/_9sdp"
                    android:layout_width="@dimen/_36sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:src="@drawable/ic_back_arrow"
                    app:tint="@color/dc_text_primary"/>
                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/DC.Text.Heading"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_16sdp"
                    android:layout_marginRight="@dimen/_16sdp"
                    android:text="@string/feedback_1"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="@dimen/_16sdp"/>
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/anim_messenger"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    app:lottie_autoPlay="true"
                    app:lottie_fileName="anim_messenger.json"
                    app:lottie_loop="true"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_main"
                android:background="@drawable/dc_bg_device_icon"
                android:padding="@dimen/_24sdp"
                android:layout_width="@dimen/_96sdp"
                android:layout_height="@dimen/_96sdp"
                android:layout_marginTop="@dimen/_16sdp"
                android:src="@drawable/ic_feedback"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ll_main"/>
            <TextView
                style="@style/DC.Text.Title"
                android:textSize="@dimen/_18ssp"
                android:gravity="center"
                android:paddingHorizontal="@dimen/_16sdp"
                android:id="@+id/txt_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:text="@string/text_tell_us_problem"
                app:layout_constraintTop_toBottomOf="@+id/img_main"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_selected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_16sdp"
                android:layout_marginRight="@dimen/_16sdp"
                android:layout_marginHorizontal="@dimen/_16sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txt_main">
                <TextView
                    android:textSize="@dimen/_12ssp"
                    android:textColor="@color/dc_text_body"
                    android:ellipsize="end"
                    android:id="@+id/txt_cant_connect"
                    android:background="@drawable/bg_item_feedback"
                    android:paddingLeft="@dimen/_14sdp"
                    android:paddingTop="@dimen/_8sdp"
                    android:paddingRight="@dimen/_14sdp"
                    android:paddingBottom="@dimen/_8sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_error_1"
                    android:maxLines="1"
                    android:fontFamily="@font/pro_display_medium"
                    android:paddingHorizontal="@dimen/_14sdp"
                    android:paddingVertical="@dimen/_8sdp"/>
                <TextView
                    android:textSize="@dimen/_12ssp"
                    android:textColor="@color/dc_text_body"
                    android:ellipsize="end"
                    android:id="@+id/txt_not_working"
                    android:background="@drawable/bg_item_feedback"
                    android:paddingLeft="@dimen/_14sdp"
                    android:paddingTop="@dimen/_8sdp"
                    android:paddingRight="@dimen/_14sdp"
                    android:paddingBottom="@dimen/_8sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_error_2"
                    android:maxLines="1"
                    android:fontFamily="@font/pro_display_medium"
                    android:paddingHorizontal="@dimen/_14sdp"
                    android:paddingVertical="@dimen/_8sdp"/>
                <TextView
                    android:textSize="@dimen/_12ssp"
                    android:textColor="@color/dc_text_body"
                    android:ellipsize="end"
                    android:id="@+id/txt_crash"
                    android:background="@drawable/bg_item_feedback"
                    android:paddingLeft="@dimen/_14sdp"
                    android:paddingTop="@dimen/_8sdp"
                    android:paddingRight="@dimen/_14sdp"
                    android:paddingBottom="@dimen/_8sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_error_3"
                    android:maxLines="1"
                    android:fontFamily="@font/pro_display_medium"
                    android:paddingHorizontal="@dimen/_14sdp"
                    android:paddingVertical="@dimen/_8sdp"/>
                <TextView
                    android:textSize="@dimen/_12ssp"
                    android:textColor="@color/dc_text_body"
                    android:ellipsize="end"
                    android:id="@+id/txt_suggestion"
                    android:background="@drawable/bg_item_feedback"
                    android:paddingLeft="@dimen/_14sdp"
                    android:paddingTop="@dimen/_8sdp"
                    android:paddingRight="@dimen/_14sdp"
                    android:paddingBottom="@dimen/_8sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_error_4"
                    android:maxLines="1"
                    android:fontFamily="@font/pro_display_medium"
                    android:paddingHorizontal="@dimen/_14sdp"
                    android:paddingVertical="@dimen/_8sdp"/>
                <TextView
                    android:textSize="@dimen/_12ssp"
                    android:textColor="@color/dc_text_body"
                    android:ellipsize="end"
                    android:id="@+id/txt_other"
                    android:background="@drawable/bg_item_feedback"
                    android:paddingLeft="@dimen/_14sdp"
                    android:paddingTop="@dimen/_8sdp"
                    android:paddingRight="@dimen/_14sdp"
                    android:paddingBottom="@dimen/_8sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_error_3"
                    android:maxLines="1"
                    android:fontFamily="@font/pro_display_medium"
                    android:paddingHorizontal="@dimen/_14sdp"
                    android:paddingVertical="@dimen/_8sdp"/>
            <androidx.constraintlayout.helper.widget.Flow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="txt_cant_connect,txt_not_working,txt_crash,txt_suggestion,txt_other"
                    app:flow_horizontalBias="0"
                    app:flow_horizontalGap="@dimen/_8sdp"
                    app:flow_horizontalStyle="packed"
                    app:flow_verticalGap="@dimen/_8sdp"
                    app:flow_wrapMode="chain"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@+id/view"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_16sdp"
                android:layout_marginRight="@dimen/_16sdp"
                android:layout_marginHorizontal="@dimen/_16sdp"
                app:layout_constraintTop_toBottomOf="@+id/cl_selected"/>
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="@dimen/_13ssp"
                android:textColor="@color/dc_text_primary"
                android:textColorHint="@color/dc_text_subtle"
                android:gravity="top"
                android:id="@+id/edt_input"
                android:background="@drawable/dc_bg_textarea"
                android:padding="@dimen/_12sdp"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_160sdp"
                android:layout_marginLeft="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginRight="@dimen/_16sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:hint="@string/text_feedback"
                android:fontFamily="@font/pro_display_regular"
                android:layout_marginHorizontal="@dimen/_16sdp"
                app:layout_constraintTop_toBottomOf="@+id/view"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <TextView
        android:textColor="@color/color_hint"
        android:gravity="center"
        android:id="@+id/btn_submit"
        android:background="@drawable/bg_button_feedback_disable"
        android:paddingLeft="@dimen/_16sdp"
        android:paddingTop="@dimen/_14sdp"
        android:paddingRight="@dimen/_16sdp"
        android:paddingBottom="@dimen/_14sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_16sdp"
        android:text="@string/submit"
        android:textSize="@dimen/_14ssp"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        android:fontFamily="@font/pro_display_bold"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingVertical="@dimen/_14sdp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
