<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/imvBanner"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:src="@drawable/banner_sale"
                android:scaleType="centerCrop"
                app:layout_constraintDimensionRatio="1.2:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/imvClose"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:layout_margin="@dimen/_16sdp"
                android:src="@drawable/ic_close_ads"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:background="@drawable/bg_content_sale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                app:layout_constraintTop_toBottomOf="@+id/imvBanner">
                <TextView
                    android:textSize="@dimen/_28sdp"
                    android:textColor="@color/color_text_new"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unlimited_access"
                    android:fontFamily="@font/pro_display_bold"/>
                <TextView
                    android:textSize="@dimen/_16sdp"
                    android:textColor="@color/color_default"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:text="@string/the_super_sale_you_ve_been_waiting_for"
                    android:fontFamily="@font/pro_display_medium"/>
                <ImageView
                    android:layout_width="@dimen/_136sdp"
                    android:layout_height="@dimen/_60sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:src="@drawable/text_50"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/_6sdp"
                    android:paddingBottom="@dimen/_6sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:paddingVertical="@dimen/_6sdp">
                    <TextView
                        android:textSize="@dimen/_28sdp"
                        android:textColor="@color/color_main"
                        android:id="@+id/tvPriceYear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pro_display_bold"/>
                    <TextView
                        android:textSize="@dimen/_24sdp"
                        android:textColor="@color/color_text_new"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/year"
                        android:fontFamily="@font/pro_display_semibold"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/_14sdp"
                    android:textColor="@color/color_text_new"
                    android:id="@+id/tvDesPriceYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/regular_price_for_year_s"
                    android:fontFamily="@font/pro_display_medium"/>
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardViewPremium"
                    android:clickable="false"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_56sdp"
                    android:layout_marginLeft="@dimen/_16sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:layout_marginRight="@dimen/_16sdp"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    app:cardCornerRadius="@dimen/_30sdp">
                    <RelativeLayout
                        android:background="@drawable/bg_button_premium_on"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_56sdp">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/rlt_sub_year"
                            android:paddingLeft="@dimen/_12sdp"
                            android:paddingRight="@dimen/_12sdp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingHorizontal="@dimen/_12sdp">
                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">
                                <TextView
                                    android:textSize="@dimen/_18sdp"
                                    android:textColor="@color/white"
                                    android:focusable="false"
                                    android:clickable="false"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/get_it_now"
                                    android:fontFamily="@font/pro_display_bold"
                                    android:textAlignment="center"/>
                            </LinearLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <View
                            android:id="@+id/shine"
                            android:background="@drawable/img_view_load"
                            android:visibility="visible"
                            android:layout_width="@dimen/_64sdp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/_minus30sdp"
                            app:layout_constraintStart_toStartOf="parent"/>
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>
                <TextView
                    android:textSize="@dimen/_14sdp"
                    android:textColor="@color/black"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:text="@string/subscription_terms"
                    android:fontFamily="@font/pro_display_medium"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_22sdp"
                    android:layout_marginTop="@dimen/_10sdp">
                    <TextView
                        android:textSize="@dimen/_13sdp"
                        android:textColor="@color/color_main"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/tvTerms"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="@string/terms_amp_conditions"
                        android:layout_weight="1"
                        android:fontFamily="@font/pro_display_medium"
                        android:textAlignment="center"/>
                    <View
                        android:textStyle="bold"
                        android:background="@color/color_main"
                        android:layout_width="1dp"
                        android:layout_height="@dimen/_20sdp"
                        android:text="|"/>
                    <TextView
                        android:textSize="@dimen/_13sdp"
                        android:textColor="@color/color_main"
                        android:gravity="center"
                        android:id="@+id/tvPolicy"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="@string/privacy_policy"
                        android:layout_weight="1"
                        android:fontFamily="@font/pro_display_medium"
                        android:textAlignment="center"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/_11sdp"
                    android:textColor="@color/color_default"
                    android:id="@+id/tvMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_16sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:layout_marginRight="@dimen/_16sdp"
                    android:layout_marginBottom="@dimen/_15sdp"
                    android:text="@string/privacy_policy_des"
                    android:fontFamily="@font/pro_display_medium"
                    android:layout_marginHorizontal="@dimen/_16sdp"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
