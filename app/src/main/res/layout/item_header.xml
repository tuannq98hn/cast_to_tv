<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ct_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/rl_itemHeader"
        android:padding="@dimen/_5sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/lnl_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true">
            <ImageView
                android:id="@+id/cast_premium"
                android:layout_width="@dimen/_95sdp"
                android:layout_height="@dimen/_28sdp"
                android:src="@drawable/imv_premium"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/_8sdp"
                android:layout_alignParentEnd="true"/>
            <ImageView
                android:id="@+id/cast_connect"
                android:background="@drawable/ripple_effect_exit"
                android:padding="@dimen/_7sdp"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:src="@drawable/ic_header_not_connect"/>
            <ImageView
                android:id="@+id/imv_how_use"
                android:background="@drawable/ripple_effect_exit"
                android:padding="@dimen/_7sdp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_how_to_use"/>
            <ImageButton
                android:layout_gravity="center"
                android:id="@+id/imv_help"
                android:background="@drawable/ic_help"
                android:padding="@dimen/_8sdp"
                android:visibility="gone"
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:layout_marginLeft="@dimen/_5sdp"
                android:layout_marginRight="@dimen/_5sdp"
                android:backgroundTint="@color/white"
                android:layout_marginHorizontal="@dimen/_5sdp"/>
            <ImageView
                android:id="@+id/imv_logout"
                android:background="@drawable/ripple_effect_exit"
                android:padding="@dimen/_7sdp"
                android:visibility="gone"
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_40sdp"
                android:src="@drawable/ic_logout"/>
            <ImageView
                android:id="@+id/imv_more"
                android:background="@drawable/ripple_effect_exit"
                android:padding="@dimen/_7sdp"
                android:visibility="gone"
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_40sdp"
                android:src="@drawable/ic_more_vert"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/imv_back"
            android:padding="@dimen/_7sdp"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:src="@drawable/ic_back_arrow"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/_18sdp"
            android:textColor="@color/color_text_new"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_5sdp"
            android:layout_marginRight="@dimen/_5sdp"
            android:text="@string/app_name"
            android:lines="1"
            android:layout_centerInParent="true"
            android:fontFamily="@font/pro_display_bold"
            android:layout_toStartOf="@+id/lnl_group"
            android:layout_toEndOf="@+id/imv_back"
            android:layout_marginHorizontal="@dimen/_5sdp"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
