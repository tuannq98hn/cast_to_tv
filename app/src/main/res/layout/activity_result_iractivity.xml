<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_intro"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/include5"
        layout="@layout/item_header"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/main_ads_native"
        app:layout_constraintTop_toBottomOf="@+id/include5">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <TextView
                android:textSize="@dimen/_13sdp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sorry"
                android:fontFamily="@font/pro_display_bold"/>
            <TextView
                android:textSize="@dimen/_10sdp"
                android:textColor="@color/text_default"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_28sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginRight="@dimen/_28sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:text="@string/des_not_support_ir"
                android:fontFamily="@font/pro_display_regular"
                android:layout_marginHorizontal="@dimen/_28sdp"
                android:layout_marginVertical="@dimen/_10sdp"/>
            <Button
                android:textSize="@dimen/_13sdp"
                android:textColor="@color/white"
                android:id="@+id/btnUseWifi"
                android:background="@drawable/bg_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_30sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:layout_marginRight="@dimen/_30sdp"
                android:text="@string/use_wifi_remote_mode"
                android:textAllCaps="false"
                android:fontFamily="@font/pro_display_bold"
                android:layout_marginHorizontal="@dimen/_30sdp"/>
        </LinearLayout>
    </RelativeLayout>
    <FrameLayout android:visibility="gone"
        android:id="@+id/main_ads_native"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
