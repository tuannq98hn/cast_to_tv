<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/include3"
        layout="@layout/item_header"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/_10sdp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginRight="@dimen/_10sdp"
            android:layout_marginHorizontal="@dimen/_10sdp">
            <com.casttotv.screen.mirroring.ui.view.SearchViewCGT
                android:id="@+id/sv_photo_online"
                android:background="@drawable/bg_search_online"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_toStartOf="@+id/rlt_tool_search"
                app:iconifiedByDefault="false"
                app:queryBackground="@null"
                app:queryHint="@string/search_here"
                app:searchIcon="@null"
                app:submitBackground="@null"/>
            <RelativeLayout
                android:id="@+id/rlt_tool_search"
                android:background="@drawable/bg_image_search"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginLeft="@dimen/_10sdp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:id="@+id/img_text_speed"
                    android:padding="@dimen/_8sdp"
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:src="@drawable/ic_text_speed"/>
            </RelativeLayout>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/_5sdp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@+id/rlt_native_ads">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_list_photo_online"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <RelativeLayout
                    android:id="@+id/rlt_not_content"
                    android:background="@color/color_bg_loading"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.casttotv.screen.mirroring.ui.view.TextViewCGT
                        android:textSize="@dimen/_15sdp"
                        android:textColor="@color/color_gray"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rlt_loading"
                    android:background="@color/color_bg_loading"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ProgressBar
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rlt_native_ads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true">
                <FrameLayout android:visibility="gone"
                    android:id="@+id/main_ads_native"
                    android:background="#f3f6ff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_5sdp"/>
            </RelativeLayout>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
