<?xml version="1.0" encoding="utf-8"?>
<!-- Dark Cinema PRO feature cards (Figma 1:175), shared by PurchaseActivity and SubSaleActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/dc_bg_glass_card"
        android:padding="@dimen/_9sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:background="@drawable/dc_bg_icon_tile_tint"
            android:backgroundTint="@color/dc_gold"
            android:padding="@dimen/_6sdp"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:src="@drawable/dc_ic_desktop"
            app:tint="@color/dc_gold"/>
        <TextView
            style="@style/DC.Text.CardTitle"
            android:textSize="@dimen/_13ssp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/_12sdp"
            android:text="@string/ultimate_screen_mirroring"/>
        <ImageView
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:src="@drawable/ic_check_v"
            app:tint="@color/dc_primary_soft"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/dc_bg_glass_card"
        android:padding="@dimen/_9sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp">
        <ImageView
            android:background="@drawable/dc_bg_icon_tile_tint"
            android:backgroundTint="@color/dc_danger"
            android:padding="@dimen/_6sdp"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:src="@drawable/dc_ic_block"
            app:tint="@color/dc_danger"/>
        <TextView
            style="@style/DC.Text.CardTitle"
            android:textSize="@dimen/_13ssp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/_12sdp"
            android:text="@string/remove_ads_in_app"/>
        <ImageView
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:src="@drawable/ic_check_v"
            app:tint="@color/dc_primary_soft"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/dc_bg_glass_card"
        android:padding="@dimen/_9sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp">
        <ImageView
            android:background="@drawable/dc_bg_icon_tile_tint"
            android:backgroundTint="@color/dc_cyan"
            android:padding="@dimen/_6sdp"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:src="@drawable/dc_ic_videocam"
            app:tint="@color/dc_primary_soft"/>
        <TextView
            style="@style/DC.Text.CardTitle"
            android:textSize="@dimen/_13ssp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/_12sdp"
            android:text="@string/improved_streaming_quality"/>
        <ImageView
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:src="@drawable/ic_check_v"
            app:tint="@color/dc_primary_soft"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/dc_bg_glass_card"
        android:padding="@dimen/_9sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp">
        <ImageView
            android:background="@drawable/dc_bg_icon_tile_tint"
            android:backgroundTint="@color/dc_violet"
            android:padding="@dimen/_6sdp"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:src="@drawable/dc_ic_sync"
            app:tint="@color/dc_violet_soft"/>
        <TextView
            style="@style/DC.Text.CardTitle"
            android:textSize="@dimen/_13ssp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/_12sdp"
            android:text="@string/all_updates_amp_new_feature"/>
        <ImageView
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:src="@drawable/ic_check_v"
            app:tint="@color/dc_primary_soft"/>
    </LinearLayout>
</LinearLayout>
