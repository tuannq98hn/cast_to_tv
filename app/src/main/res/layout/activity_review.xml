<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@drawable/img_review"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toTopOf="@+id/clContainerRate"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clContainerRate"
        android:background="@drawable/bg_stoke_primary"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="32dp"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintBottom_toTopOf="@+id/btnNext">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12sp"
            android:textColor="#202020"
            android:id="@+id/tvRateTitle"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_22sdp"
            android:text="Love it!"
            android:includeFontPadding="false"
            android:fontFamily="@font/pro_display_bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivRateNum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img_five_rate"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvRateTitle"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="11sp"
            android:textColor="#202020"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_24sdp"
            android:text="7 Nov"
            android:includeFontPadding="false"
            android:fontFamily="@font/roboto_medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="11sp"
            android:textColor="#323232"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_24sdp"
            android:text="by Kimberly “Grace” Tushaus"
            android:fontFamily="@font/roboto_medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvRateTitle"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12sp"
            android:textColor="#202020"
            android:id="@+id/tvRateDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:text="Works great! I really appreciate being able to watch my phone content seamlessly from my phone to the television. Thanks for a great app!"
            android:lineSpacingExtra="@dimen/_4sdp"
            android:fontFamily="@font/roboto_regular"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivRateNum"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/btnNext"
        android:background="@drawable/bg_rounder_ads"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="24dp"
        android:text="@string/start"
        android:textAllCaps="false"
        android:fontFamily="@font/pro_display_bold"
        android:layout_marginHorizontal="20dp"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
