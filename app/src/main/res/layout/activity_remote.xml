<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_background_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <include
            android:id="@+id/include"
            layout="@layout/item_header"/>
    </LinearLayout>
    <com.casttotv.screen.mirroring.customview.CustomViewPager
        android:id="@+id/vpHomeMain"
        android:paddingTop="@dimen/_16sdp"
        android:paddingBottom="@dimen/_16sdp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingVertical="@dimen/_16sdp"
        app:layout_constraintBottom_toTopOf="@+id/main_ads_native"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llBottom"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llBottom"
        android:background="@drawable/bg_tabar_remote"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_36sdp"
        android:layout_marginLeft="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginRight="@dimen/_16sdp"
        android:layout_marginHorizontal="@dimen/_16sdp"
        app:layout_constraintTop_toBottomOf="@+id/llHeader">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/llRemote"
            android:background="@drawable/bg_item_tab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/imvRemote"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:src="@drawable/ic_tab_remote_on"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/llTouchPad"
            android:background="@drawable/ripple_effect_color_main"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/imvTouchPad"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:src="@drawable/ic_tab_touch_off"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/llNumber"
            android:background="@drawable/ripple_effect_color_main"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/imvNumber"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:src="@drawable/ic_tab_number_off"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/llChannel"
            android:background="@drawable/ripple_effect_color_main"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/imvChannel"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:src="@drawable/ic_tab_channel_off"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:visibility="gone"
        android:id="@+id/main_ads_native"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
