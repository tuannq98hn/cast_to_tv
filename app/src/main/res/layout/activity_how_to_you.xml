<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/dc_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/include5"
        layout="@layout/item_header"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcv_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_got_it"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:clipToPadding="false"
        android:paddingTop="@dimen/_4sdp"
        app:layout_constraintTop_toBottomOf="@+id/include5"/>
    <Button
        style="@style/DC.Text.Button"
        android:textColor="@color/dc_text_primary"
        android:id="@+id/btn_got_it"
        android:background="@drawable/dc_bg_cta_gradient"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_44sdp"
        android:layout_margin="@dimen/_16sdp"
        android:text="@string/i_got_it"
        android:textAllCaps="false"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rcv_list"/>
</androidx.constraintlayout.widget.ConstraintLayout>
