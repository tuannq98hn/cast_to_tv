<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/transparency"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="@dimen/_400sdp">
    <RelativeLayout
        android:background="@drawable/bg_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_400sdp"
        android:maxHeight="@dimen/_400sdp"
        app:layout_constraintBottom_toBottomOf="parent">
        <View
            android:id="@+id/viewHeader"
            android:background="@drawable/bg_line_remote"
            android:layout_width="@dimen/_48sdp"
            android:layout_height="@dimen/_4sdp"
            android:layout_marginTop="@dimen/_15sdp"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/_18sdp"
            android:textColor="@color/color_text_new"
            android:id="@+id/tv_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_10sdp"
            android:text="@string/playlist"
            android:layout_below="@+id/viewHeader"
            android:fontFamily="@font/pro_display_bold"
            android:layout_marginStart="@dimen/_20sdp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcv_quickly_list"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/tv_text"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
