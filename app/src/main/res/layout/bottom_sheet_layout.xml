<?xml version="1.0" encoding="utf-8"?>
<!-- Dark Cinema playlist sheet (dc_bg_sheet). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparency"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:background="@drawable/dc_bg_sheet"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_400sdp"
        app:layout_constraintBottom_toBottomOf="parent">
        <View
            android:id="@+id/viewHeader"
            android:background="@color/dc_divider"
            android:layout_width="@dimen/_48sdp"
            android:layout_height="@dimen/_4sdp"
            android:layout_marginTop="@dimen/_12sdp"
            android:layout_centerHorizontal="true"/>
        <TextView
            style="@style/DC.Text.Heading"
            android:id="@+id/tv_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/_12sdp"
            android:text="@string/playlist"
            android:layout_below="@+id/viewHeader"
            android:layout_marginStart="@dimen/_20sdp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcv_quickly_list"
            android:paddingHorizontal="@dimen/_8sdp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/tv_text"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
