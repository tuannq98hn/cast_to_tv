<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_install_channel_roku_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.casttotv.screen.mirroring.customview.CustomViewPager
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="360:320"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@drawable/bg_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_minus10sdp"
        app:layout_constraintTop_toBottomOf="@+id/viewPager"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/llContentAdd"
        android:paddingBottom="@dimen/_40sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/viewPager">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_40sdp"
            android:layout_marginBottom="@dimen/_12sdp">
            <TextView
                android:textSize="@dimen/_18sdp"
                android:textColor="@color/text_color"
                android:gravity="center"
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:fontFamily="@font/pro_display_bold"/>
            <com.casttotv.screen.mirroring.customview.DotsTextView
                android:textSize="@dimen/_24sdp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tvDot"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_install_3"
                android:fontFamily="@font/pro_display_bold"
                android:layout_marginStart="@dimen/_5sdp"
                app:autoplay="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/constraintLayout"
                app:period="1000"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/_12sdp"
            android:textColor="@color/text_color_default"
            android:gravity="center_horizontal"
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="@dimen/_40sdp"
            android:text="@string/des_channel_roku_1"
            android:lines="3"
            android:fontFamily="@font/roboto_regular"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintBottom_toTopOf="@+id/btnAction"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/imvDot1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_dot_selected"/>
            <ImageView
                android:id="@+id/imvDot2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_dot_off"
                android:layout_marginStart="@dimen/_5sdp"/>
            <ImageView
                android:id="@+id/imvDot3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_dot_off"
                android:layout_marginStart="@dimen/_5sdp"/>
            <ImageView
                android:id="@+id/imvDot4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_dot_off"
                android:layout_marginStart="@dimen/_5sdp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llNumber"
        android:tag="binding_1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_10sdp"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout25">
        <include
            android:id="@+id/llKeyBoardNumber"
            layout="@layout/layout_number_add_channel"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/linearLayout25"
        android:paddingTop="@dimen/_16sdp"
        android:paddingBottom="@dimen/_16sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/_16sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llContentAdd">
        <Button
            android:textSize="@dimen/_14sdp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btnAction"
            android:background="@drawable/bg_button_all"
            android:padding="@dimen/_4sdp"
            android:layout_width="@dimen/_240sdp"
            android:layout_height="@dimen/_42sdp"
            android:text="@string/tap_to_start"
            android:textAllCaps="false"
            android:fontFamily="@font/pro_display_bold"
            app:layout_constraintBottom_toTopOf="@+id/tabLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="@dimen/_16sdp"
            android:textColor="@color/text_color"
            android:id="@+id/tvLater"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:text="@string/later"
            android:fontFamily="@font/roboto_regular"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
