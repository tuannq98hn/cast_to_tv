<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/dc_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="-28dp"
        app:layout_constraintBottom_toTopOf="@+id/clButton"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/imvClose"
        android:background="@drawable/dc_bg_icon_button"
        android:padding="@dimen/_8sdp"
        android:visibility="gone"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="@dimen/_32sdp"
        android:layout_margin="@dimen/_16sdp"
        android:src="@drawable/ic_close_black"
        app:tint="@color/dc_text_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_132sdp"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="16sp"
            android:textColor="@color/dc_text_on_primary"
            android:fontFamily="@font/pro_display_bold"
            android:id="@+id/btnNext"
            android:background="@drawable/dc_bg_cta_onboarding"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="@dimen/_16sdp"
            android:layout_marginRight="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_24sdp"
            android:textAllCaps="false"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:paddingVertical="16dp"
            app:layout_constraintBottom_toTopOf="@+id/indicatorView"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clProgress"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_16sdp"
            android:layout_marginRight="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_24sdp"
            android:layout_marginHorizontal="@dimen/_16sdp"
            app:layout_constraintBottom_toTopOf="@+id/indicatorView">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/dc_text_muted"
                android:gravity="center"
                android:id="@+id/tvLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/LOADING"
                android:fontFamily="@font/pro_display_regular"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.casttotv.screen.mirroring.ui.activities.new_intro.DynamicProgressBar
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginTop="@dimen/_12sdp"
                app:currentProgress="6"
                app:layout_constraintTop_toBottomOf="@+id/tvLoading"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/dc_text_primary"
                android:id="@+id/tvProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pro_display_bold"
                app:layout_constraintBottom_toBottomOf="@+id/progress"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/progress"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.tbuonomo.viewpagerdotsindicator.WormDotsIndicator
            android:id="@+id/indicatorView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_24sdp"
            android:layout_centerHorizontal="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:dotsColor="@color/dc_primary"
            app:dotsStrokeColor="@color/dc_radio_off"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/llConnect"
        android:background="@color/dc_scrim"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/dc_bg_dialog"
            android:paddingLeft="@dimen/_21sdp"
            android:paddingTop="@dimen/_40sdp"
            android:paddingRight="@dimen/_21sdp"
            android:paddingBottom="@dimen/_40sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_40sdp"
            android:paddingHorizontal="@dimen/_21sdp"
            android:paddingVertical="@dimen/_40sdp"
            app:layout_constraintTop_toTopOf="parent">
            <com.airbnb.lottie.LottieAnimationView
                android:layout_gravity="center"
                android:id="@+id/lottieConnecting"
                android:layout_width="@dimen/_80sdp"
                android:layout_height="@dimen/_80sdp"
                app:lottie_autoPlay="true"
                app:lottie_fileName="anim_loading.json"
                app:lottie_loop="true"/>
            <com.airbnb.lottie.LottieAnimationView
                android:layout_gravity="center"
                android:id="@+id/lottieConnected"
                android:visibility="gone"
                android:layout_width="@dimen/_80sdp"
                android:layout_height="@dimen/_80sdp"
                app:lottie_fileName="anim_success_connect.json"/>
            <com.airbnb.lottie.LottieAnimationView
                android:layout_gravity="center"
                android:id="@+id/lottieConnectFail"
                android:visibility="gone"
                android:layout_width="@dimen/_80sdp"
                android:layout_height="@dimen/_80sdp"
                app:lottie_fileName="anim_fail_connect.json"/>
            <TextView
                android:textSize="@dimen/_11sdp"
                android:textColor="@color/dc_text_primary"
                android:gravity="center"
                android:id="@+id/tvStatusConnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_30sdp"
                android:text="@string/connecting"
                android:fontFamily="@font/pro_display_bold"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
