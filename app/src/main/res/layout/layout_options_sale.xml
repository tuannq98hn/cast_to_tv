<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/testing_1_button_month"
        android:background="@drawable/bg_button_premium_off"
        android:paddingLeft="@dimen/_16sdp"
        android:paddingTop="@dimen/_12sdp"
        android:paddingRight="@dimen/_16sdp"
        android:paddingBottom="@dimen/_12sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_16sdp"
        android:layout_marginRight="@dimen/_16sdp"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingVertical="@dimen/_12sdp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="@dimen/_14sdp"
                android:textColor="@color/color_text_new"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/monthly"
                android:fontFamily="@font/pro_display_bold"/>
            <TextView
                android:textSize="@dimen/_11sdp"
                android:textColor="@color/color_default"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_renewing_monthly"
                android:fontFamily="@font/pro_display_regular"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="end"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true">
            <TextView
                android:textSize="@dimen/_16sdp"
                android:textColor="@color/color_text_new"
                android:id="@+id/testing_1_button_month_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pro_display_bold"/>
            <TextView
                android:textSize="@dimen/_11sdp"
                android:textColor="@color/color_default"
                android:id="@+id/tv_price_sale_month"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pro_display_regular"/>
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/testing_1_button_one_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_16sdp"
        android:layout_marginRight="@dimen/_16sdp"
        android:layout_marginHorizontal="@dimen/_16sdp">
        <RelativeLayout
            android:background="@drawable/bg_button_premium_off"
            android:paddingLeft="@dimen/_16sdp"
            android:paddingTop="@dimen/_12sdp"
            android:paddingRight="@dimen/_16sdp"
            android:paddingBottom="@dimen/_12sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:paddingHorizontal="@dimen/_16sdp"
            android:paddingVertical="@dimen/_12sdp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true">
                <TextView
                    android:textSize="@dimen/_14sdp"
                    android:textColor="@color/color_text_new"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/life_time"
                    android:fontFamily="@font/pro_display_bold"/>
                <TextView
                    android:textSize="@dimen/_11sdp"
                    android:textColor="@color/color_default"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/one_time_payment"
                    android:fontFamily="@font/pro_display_regular"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="end"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true">
                <TextView
                    android:textSize="@dimen/_16sdp"
                    android:textColor="@color/color_text_new"
                    android:id="@+id/testing_1_button_one_time_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pro_display_bold"/>
                <TextView
                    android:textSize="@dimen/_11sdp"
                    android:textColor="@color/color_default"
                    android:id="@+id/tv_price_sale_lifetime"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pro_display_regular"/>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>
