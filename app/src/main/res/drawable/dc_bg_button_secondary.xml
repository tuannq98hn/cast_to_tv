<?xml version="1.0" encoding="utf-8"?>
<!-- Dark Cinema secondary button (QR button style): #262a34cc, 1dp glass stroke, r16. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/dc_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dc_segment_track"/>
            <stroke android:width="1dp" android:color="@color/dc_glass_stroke"/>
            <corners android:radius="@dimen/_16sdp"/>
        </shape>
    </item>
</ripple>
