<?xml version="1.0" encoding="utf-8"?>
<!-- Dark Cinema player stop button (Cast Player "Button - Disconnect Cast"): #93000a4d, 1dp glass stroke, circle. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/dc_ripple">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/dc_player_stop"/>
            <stroke android:width="1dp" android:color="@color/dc_glass_stroke"/>
        </shape>
    </item>
</ripple>
