    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/dc_cyan" android:endColor="@color/dc_indigo_soft"/>
            <corners android:radius="999dp"/>
        </shape>
    </item>
</ripple>
