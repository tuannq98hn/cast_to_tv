<?xml version="1.0" encoding="utf-8"?>
<!-- Dark Cinema onboarding backdrop (Figma Onboarding Intro): radial(50% 30%, #00f2fe38, #8e2de226, transparent) + violet/cyan corner glows. No blur. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/dc_bg"/>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.5" android:centerY="0.3" android:gradientRadius="110%p"
                android:startColor="@color/dc_glow_cyan" android:centerColor="@color/dc_glow_purple" android:endColor="@android:color/transparent"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.95" android:centerY="0.0" android:gradientRadius="70%p"
                android:startColor="@color/dc_glow_purple" android:endColor="@android:color/transparent"/>
        </shape>
    </item>
</layer-list>
