    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#b8171c25" android:endColor="#e00f131d"/>
            <stroke android:width="1dp" android:color="#3322d3ee"/>
            <corners android:radius="@dimen/_16sdp"/>
        </shape>
    </item>
</ripple>
