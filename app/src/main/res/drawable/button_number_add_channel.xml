<?xml version="1.0" encoding="utf-8"?>
<!-- Dark Cinema keypad key (Install Channel Roku PIN pad): dc_bg_key look, cyan stroke when pressed/selected. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/dc_icon_tile_start"/>
            <stroke android:width="1dp" android:color="@color/dc_primary_soft"/>
            <corners android:radius="@dimen/_12sdp"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/dc_icon_tile_start"/>
            <stroke android:width="1dp" android:color="@color/dc_primary_soft"/>
            <corners android:radius="@dimen/_12sdp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/dc_key_start" android:endColor="@color/dc_key_end"/>
            <stroke android:width="1dp" android:color="@color/dc_key_stroke"/>
            <corners android:radius="@dimen/_12sdp"/>
        </shape>
    </item>
</selector>
