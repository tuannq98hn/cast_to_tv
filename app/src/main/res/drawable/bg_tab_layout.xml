<?xml version="1.0" encoding="utf-8"?>
<!-- Video Hub segmented tab (Stitch): active pill white/8 with a white/10 edge, inactive transparent. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_12sdp"/>
            <solid android:color="#14ffffff"/>
            <stroke android:width="1dp" android:color="#1affffff"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_12sdp"/>
            <solid android:color="@android:color/transparent"/>
        </shape>
    </item>
</selector>
