<?xml version="1.0" encoding="utf-8"?>
<!-- Dark Cinema primary pill (Install Channel Roku action, enabled): linear-gradient(90deg, #3131c0, #3b49df), fully rounded. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/dc_ripple">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/dc_chip_active_start" android:endColor="@color/dc_cta_pill_end"/>
            <stroke android:width="1dp" android:color="@color/dc_primary_soft"/>
            <corners android:radius="999dp"/>
        </shape>
    </item>
</ripple>
