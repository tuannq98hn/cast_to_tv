<?xml version="1.0" encoding="utf-8"?>
<!-- Stitch PRO Upgrade TV screen: gradient (to top right, indigo-950, slate-900, cyan-950), cyan light ray at the top, 1dp cyan-500/20, r8. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="45" android:startColor="#1e1b4b" android:centerColor="#0f172a" android:endColor="#083344"/>
            <corners android:radius="@dimen/_6sdp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.5" android:centerY="0.0" android:gradientRadius="35%p"
                android:startColor="#3300f2fe" android:endColor="@android:color/transparent"/>
            <corners android:radius="@dimen/_6sdp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#3306b6d4"/>
            <corners android:radius="@dimen/_6sdp"/>
        </shape>
    </item>
</layer-list>
