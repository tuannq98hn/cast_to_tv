<?xml version="1.0" encoding="utf-8"?>
<!-- Stitch Main Hub Screen Mirror hero: linear-gradient(to bottom right, #312e81e6, #0d1730, #042838),
     cyan glow blob top-right, 1dp cyan-400/30 edge, r26, ripple. No shadow/blur. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/dc_ripple">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="315" android:startColor="#e6312e81" android:centerColor="#0d1730" android:endColor="#042838"/>
                    <corners android:radius="@dimen/_20sdp"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:type="radial" android:centerX="0.95" android:centerY="0.0" android:gradientRadius="45%p"
                        android:startColor="#3322d3ee" android:endColor="@android:color/transparent"/>
                    <corners android:radius="@dimen/_20sdp"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="1dp" android:color="#4d22d3ee"/>
                    <corners android:radius="@dimen/_20sdp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
