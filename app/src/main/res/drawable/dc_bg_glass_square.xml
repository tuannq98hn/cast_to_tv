<?xml version="1.0" encoding="utf-8"?>
<!-- Stitch remote header back key: dark glass rounded-square (rounded-xl), 1dp white/8, r10, ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/dc_ripple">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/dc_key_start" android:endColor="@color/dc_key_end"/>
            <stroke android:width="1dp" android:color="@color/dc_key_stroke"/>
            <corners android:radius="@dimen/_9sdp"/>
        </shape>
    </item>
</ripple>
