<?xml version="1.0" encoding="utf-8"?>
<!-- Dark Cinema language row (Figma Language Selection): idle #131a2a94 + glass stroke; selected linear-gradient(168deg, #082f4980, #0e223da6) + cyan stroke. r16. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/dc_ripple">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="@color/dc_lang_selected_start" android:endColor="@color/dc_lang_selected_end"/>
                    <stroke android:width="1dp" android:color="@color/dc_lang_selected_stroke"/>
                    <corners android:radius="@dimen/_16sdp"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/dc_lang_card"/>
                    <stroke android:width="1dp" android:color="@color/dc_key_stroke"/>
                    <corners android:radius="@dimen/_16sdp"/>
                </shape>
            </item>
        </selector>
    </item>
</ripple>
