<?xml version="1.0" encoding="utf-8"?>
<!-- Dark Cinema web hub tile / history card (Web Video Cast "YouTube Tile", "History Card"): #262a3480, 1dp glass stroke, r16. No real blur. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/dc_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dc_web_tile"/>
            <stroke android:width="1dp" android:color="@color/dc_glass_stroke"/>
            <corners android:radius="@dimen/_16sdp"/>
        </shape>
    </item>
</ripple>
