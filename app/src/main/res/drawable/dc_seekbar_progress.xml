<?xml version="1.0" encoding="utf-8"?>
<!-- Dark Cinema scrubber (Cast Player "Interactive Progress Track"): track #31353f, played linear-gradient(90deg, #3131c0, #00f2fe), r999. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical|fill_horizontal" android:height="@dimen/_6sdp">
        <shape android:shape="rectangle">
            <solid android:color="@color/dc_player_track"/>
            <corners android:radius="999dp"/>
        </shape>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical|fill_horizontal" android:height="@dimen/_6sdp">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <gradient android:angle="0" android:startColor="@color/dc_chip_active_start" android:endColor="@color/dc_primary"/>
                <corners android:radius="999dp"/>
            </shape>
        </scale>
    </item>
</layer-list>
